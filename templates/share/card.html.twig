{# A shared card on a page of its own, outside the back office: nothing that needs signing in, the reference's summary only; its markdown to rewrite when the link is the editing one #}
<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ card.title }}</title>
    {# The site's content security policy may carry a nonce, which an inline style needs to be applied #}
    <style{% guard function csp_nonce %} nonce="{{ csp_nonce('style') }}"{% endguard %}>
        body { margin: 0; padding: 1rem; font: 1rem/1.55 system-ui, sans-serif; color: #212529; background: #f8f9fa; }
        main { max-width: 46rem; margin: 0 auto; padding: 1.25rem; background: #fff; border-radius: .5rem; box-shadow: 0 1px 3px rgb(0 0 0 / .08); }
        h1 { margin: 0 0 .25rem; font-size: 1.5rem; line-height: 1.25; }
        h2 { margin: 1.75rem 0 .5rem; font-size: 1.1rem; }
        .pilot-share-meta { color: #6c757d; font-size: .9rem; }
        .pilot-share-steps { list-style: none; padding-left: 0; margin: 0; }
        .pilot-share-steps li { padding: .35rem 0; border-bottom: 1px solid #e9ecef; }
        .pilot-share-done { color: #6c757d; }
        .pilot-share-done .pilot-share-text { text-decoration: line-through; }
        .pilot-share-inline { display: inline; }
        .pilot-share-inline button { font: inherit; font-size: .85rem; padding: .05rem .45rem; cursor: pointer; border: 1px solid #ced4da; border-radius: .25rem; background: #fff; color: inherit; }
        .pilot-share-inline button:disabled { opacity: .45; cursor: not-allowed; }
        .pilot-share-waiting { color: #adb5bd; }
        .pilot-share-note h1, .pilot-share-note h2 { font-size: 1.05rem; margin: 1.25rem 0 .4rem; }
        .pilot-share-note h3, .pilot-share-note h4 { font-size: .95rem; margin: 1rem 0 .3rem; }
        .pilot-share-note ul { padding-left: 1.25rem; }
        details > summary { cursor: pointer; font-weight: 600; margin: 1.5rem 0 .5rem; }
        code { font-size: .85em; }
        /* A screenshot opened full size over the page by its anchor, without a script, closed by a click anywhere without scrolling back up */
        .pilot-share-zoom { display: none; position: fixed; inset: 0; z-index: 10; align-items: center; justify-content: center; background: rgb(0 0 0 / .75); cursor: zoom-out; }
        .pilot-share-zoom:target { display: flex; }
        .pilot-share-zoom img { max-width: calc(100vw - 2rem); max-height: calc(100vh - 2rem); border-radius: .5rem; }
        .pilot-share-edit textarea { box-sizing: border-box; width: 100%; min-height: 24rem; font: .85rem/1.4 ui-monospace, monospace; color: inherit; background: transparent; }
        @media (prefers-color-scheme: dark) {
            body { color: #dee2e6; background: #16191c; }
            main { background: #212529; box-shadow: none; }
            .pilot-share-meta, .pilot-share-done { color: #adb5bd; }
            .pilot-share-waiting { color: #6c757d; }
            .pilot-share-steps li { border-color: #343a40; }
            .pilot-share-inline button { background: #2b3035; border-color: #495057; }
        }
    </style>
</head>
<body>
<main>
    <h1>{{ card.title }}</h1>
    <p class="pilot-share-meta">
        {{ card.project.name }} · {{ card.status.label|trans }}
        {% if card.due %} · {{ card.due|format_date('long') }}{% endif %}
        {% if card.waitingOn %} · {{ 'label.waiting_on'|trans({'%who%': card.waitingOn}, 'pilot') }}{% endif %}
        {% if card.sourceUrl %} · <a href="{{ card.sourceUrl }}" rel="noopener noreferrer">{{ 'label.card_source'|trans({}, 'pilot') }}</a>{% endif %}
        {% if card.resultUrl %} · <a href="{{ card.resultUrl }}" rel="noopener noreferrer">{{ 'label.card_result'|trans({}, 'pilot') }}</a>{% endif %}
    </p>

    {% if run and run.step is null and run.action not in card.checklist|map(step => step.action ?? null) %}
        {# Where the card's last machine run stands, when it is not one of its steps' (shown on that step) #}
        <p class="pilot-share-meta">{{ 'label.machine'|trans({}, 'pilot') }} · {{ run.action }} · {{ run.status.label|trans }}{% if run.status.value == 'claimed' %} · {{ run.progress }} %{% endif %}{% if run.message %} · {{ run.message }}{% endif %}</p>
    {% endif %}

    {% if card.steps is not empty %}
        <h2>{{ 'label.share_steps'|trans({}, 'pilot') }}</h2>
        {# The steps, ticked and launched from here through the editing link, each naming the machine action it hands the card to, under the name of their group #}
        {% set step_runs = card.stepRuns %}
        {% for run in card.stepGroups %}
        {% if run.group %}<h3>{{ run.group }}</h3>{% endif %}
        <ul class="pilot-share-steps">
            {% for index, step in run.steps %}
                {% set done = step.done ?? false %}
                <li{{ done ? ' class="pilot-share-done"' }}>
                    {% include '@c975LPilot/share/_tick.html.twig' %}
                    {% if editable and not loop.first and not (card.template and card.template.checklist) %}
                        {# One place up, the new order going to the card's template and its other cards #}
                        <form method="post" action="{{ path('pilot_share_gesture', {token: token, gesture: 'stepup'}) }}" class="pilot-share-inline">
                            <input type="hidden" name="page" value="1"><input type="hidden" name="index" value="{{ index }}">
                            <button title="{{ 'label.step_up'|trans({}, 'pilot') }}" aria-label="{{ 'label.step_up'|trans({}, 'pilot') }}">↑</button>
                        </form>
                    {% endif %}
                    {% set waiting = not done and card.isStepWaiting(index) %}
                    <span class="pilot-share-text{{ waiting ? ' pilot-share-waiting' }}">{{ step.t }}</span>{% if step.due is defined %} <small>· {{ step.due|date('d/m/Y') }}</small>{% endif %}
                    {% if step.action is defined %}
                        {% if not editable %}<code>{{ step.action }}</code>{% endif %}
                        {% set step_run = step_runs[index] ?? null %}
                        {% set busy = step_run and step_run.status.value in ['queued', 'claimed'] %}
                        {% if busy or (step_run and not done and step_run.status.value in ['failed', 'blocked']) %}
                            <strong>{{ step_run.status.label|trans }}{% if step_run.status.value == 'claimed' %} · {{ step_run.progress }} %{% endif %}</strong>{% if step_run.message %} <span class="pilot-share-meta">{{ step_run.message }}</span>{% endif %}
                        {% endif %}
                        {% if editable and busy %}
                            <form method="post" action="{{ path('pilot_share_gesture', {token: token, gesture: 'cancel'}) }}" class="pilot-share-inline">
                                <input type="hidden" name="page" value="1"><input type="hidden" name="run" value="{{ step_run.id }}">
                                {% set stop_label = step_run.status.value == 'claimed' ? 'label.run_stop'|trans({}, 'pilot') : 'label.run_cancel'|trans({}, 'pilot') %}<button title="{{ stop_label }}" aria-label="{{ stop_label }}">{{ step_run.status.value == 'claimed' ? '■' : '✕' }}</button>
                            </form>
                        {% endif %}
                        {% if editable and not done and not busy and card.status.value not in ['review', 'done'] %}
                            <form method="post" action="{{ path('pilot_share_gesture', {token: token, gesture: 'runstep'}) }}" class="pilot-share-inline">
                                <input type="hidden" name="page" value="1"><input type="hidden" name="index" value="{{ index }}">
                                <button{% if waiting %} disabled{% endif %} title="{{ waiting ? 'label.step_waiting'|trans({'%steps%': card.stepAwaits(index)|join(', ')}, 'pilot') : 'label.step_run'|trans({}, 'pilot') }}">▶ {{ action_labels[step.action] ?? step.action }}</button>
                            </form>
                        {% endif %}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {% endfor %}
    {% endif %}

    {% if card.feedback is not empty or editable %}
        <h2>{{ 'label.feedback'|trans({}, 'pilot') }}</h2>
        {# The feedback on the card, ticked from here through the editing link, its screenshot small beside it #}
        <ul class="pilot-share-steps">
            {% for index, step in card.feedback %}
                {% set done = step.done ?? false %}
                <li{{ done ? ' class="pilot-share-done"' }}>
                    {% include '@c975LPilot/share/_tick.html.twig' %}
                    <span class="pilot-share-text">{{ step.t }}</span>
                    {% if step.img is defined %}{% set shot = path('pilot_feedback_image', {name: step.img}) %}<a href="#shot-{{ index }}"><img src="{{ shot }}" alt="{{ 'label.feedback_image_view'|trans({}, 'pilot') }}" height="80" loading="lazy"></a><a href="#shot-closed" id="shot-{{ index }}" class="pilot-share-zoom" aria-label="{{ 'label.close'|trans({}, 'pilot') }}"><img src="{{ shot }}" alt="{{ 'label.feedback_image_view'|trans({}, 'pilot') }}" loading="lazy"></a>{% endif %}
                </li>
            {% endfor %}
        </ul>
        {% if editable %}
            <form method="post" action="{{ path('pilot_share_gesture', {token: token, gesture: 'feedback'}) }}">
                <input type="hidden" name="page" value="1">
                <input name="text" maxlength="500" required placeholder="{{ 'label.info_feedback_add'|trans({}, 'pilot') }}" aria-label="{{ 'label.feedback_add'|trans({}, 'pilot') }}">
                <button>{{ 'label.feedback_add'|trans({}, 'pilot') }}</button>
            </form>
        {% endif %}
    {% endif %}

    {% if actions is not empty and card.status.value not in ['running', 'done'] %}
        {# The actions offered on the project that ask nothing, handed the card in one click #}
        <p>
            {% for action in actions %}
                <form method="post" action="{{ path('pilot_share_gesture', {token: token, gesture: 'entrust'}) }}" class="pilot-share-inline">
                    <input type="hidden" name="page" value="1"><input type="hidden" name="action" value="{{ action.key }}">
                    <button title="{{ action.help ? action.help ~ ' · ' }}{{ action.machine }}">{{ action.label }}</button>
                </form>
            {% endfor %}
        </p>
    {% endif %}

    {% if card.note %}
        {# The description after the steps, folded when it is long so the steps stay in sight #}
        {% if card.note|length > 1500 %}
            <details class="pilot-share-note"><summary>{{ 'label.share_description'|trans({}, 'pilot') }}</summary>{{ card.note|pilot_markdown }}</details>
        {% else %}
            <h2>{{ 'label.share_description'|trans({}, 'pilot') }}</h2>
            <div class="pilot-share-note">{{ card.note|pilot_markdown }}</div>
        {% endif %}
    {% endif %}

    {% if card.doc and card.doc.summary %}
        <section>
            <h2>{{ card.doc.title }}</h2>
            {{ card.doc.summary|pilot_markdown }}
        </section>
    {% endif %}

    {% if editable %}
        <details>
        <summary>{{ 'label.share_rewrite'|trans({}, 'pilot') }}</summary>
        <form method="post" action="{{ path('pilot_share_save', {token: token}) }}" class="pilot-share-edit">
            <p class="pilot-share-meta">{{ 'label.info_share_edit'|trans({}, 'pilot') }} <a href="{{ path('pilot_share_markdown', {token: token}) }}">.md</a></p>
            <textarea name="markdown" aria-label="{{ 'label.share_edit'|trans({}, 'pilot') }}">{{ markdown }}</textarea>
            <p><button>{{ 'label.card_save'|trans({}, 'pilot') }}</button></p>
        </form>
        </details>
    {% endif %}
</main>
</body>
</html>
