{% extends '@c975LPilot/management/_layout.html.twig' %}

{% block pilot %}
    <h1>{{ 'label.search'|trans({}, 'pilot') }}</h1>
    <p class="text-body-secondary">{{ 'label.info_search'|trans({}, 'pilot') }}</p>
    <form method="get" class="mb-4">
        <input type="search" name="q" value="{{ words }}" class="form-control" placeholder="{{ 'label.search_placeholder'|trans({}, 'pilot') }}" autofocus>
    </form>

    {% if cards is not empty %}
        <div class="pilot-cards mb-4">
            {% for card in cards %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
        </div>
    {% endif %}
    {% for doc in docs %}{% include '@c975LPilot/management/_doc.html.twig' %}{% endfor %}
    {% if words|length >= 2 and cards is empty and docs is empty %}
        <p>{{ 'label.nothing_found'|trans({}, 'pilot') }}</p>
    {% endif %}
{% endblock %}
