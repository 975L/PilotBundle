{% extends '@c975LPilot/management/_layout.html.twig' %}

{# A file on its own page, the part the dialog of the listing pages takes; a character shows its portrait at full size, to download as a reference #}
{% block pilot %}
    <div class="pilot-dialog-page">
        {% if doc.kind.value == 'character' %}
            <h1>{{ doc.title }}</h1>
            {% if doc.summary %}<p class="text-body-secondary">{{ doc.summary }}</p>{% endif %}
            {% if doc.image %}
                {% set image = path('management_pilot_doc_image', {slug: doc.slug}) %}
                <img src="{{ image }}" alt="{{ doc.title }}" class="img-fluid rounded mb-2 pilot-character-full">
                <p><a href="{{ image }}" download="{{ doc.image }}" class="btn btn-sm btn-outline-primary pilot-character-download"><i class="fas fa-download me-1"></i>{{ 'label.character_image'|trans({}, 'pilot') }}</a></p>
            {% endif %}
            {% if doc.detail %}<div class="small">{{ doc.detail|pilot_markdown }}</div>{% endif %}
        {% else %}
            {% include '@c975LPilot/management/_doc.html.twig' with {open: true} %}
        {% endif %}

        {# A new request added here points to this reference; its memory: the cards pointing to it, the open ones first, then the done ones #}
        {% if doc.project and doc.kind.value not in ['character', 'objectives'] %}
            <h2 class="h5 mt-4">{{ 'label.card_new'|trans({}, 'pilot') }}</h2>
            {% include '@c975LPilot/management/_card_new.html.twig' with {new_project: doc.project, new_doc: doc} %}
        {% endif %}
        {% set done = cards|filter(card => card.status.value == 'done') %}
        {% set open = cards|filter(card => card.status.value != 'done') %}
        {% if open is not empty %}
            <h2 class="h5 mt-4">{{ 'label.cards'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards pilot-doc-cards">
                {% for card in open %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
            </div>
        {% endif %}
        {% if done is not empty %}
            <details class="mt-4">
                <summary>{{ 'label.done_cards'|trans({'%count%': done|length}, 'pilot') }}</summary>
                <div class="pilot-cards mt-2">
                    {% for card in done %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
                </div>
            </details>
        {% endif %}

        {# The title and the two floors written here, the summary for a human, the detail for Claude #}
        <details class="mt-3 pilot-doc-form">
            <summary>{{ 'label.doc_edit'|trans({}, 'pilot') }}</summary>
            <form method="post" action="{{ path('management_pilot_doc_edit', {slug: doc.slug}) }}" class="d-grid gap-2 mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('pilot_doc_edit' ~ doc.id) }}">
                <label class="form-label mb-0">{{ 'label.card_title'|trans({}, 'pilot') }}
                    <input name="title" value="{{ doc.title }}" maxlength="200" class="form-control" required>
                </label>
                <label class="form-label mb-0">{{ 'label.doc_summary'|trans({}, 'pilot') }}
                    <textarea name="summary" rows="5" class="form-control">{{ doc.summary }}</textarea>
                </label>
                <label class="form-label mb-0">{{ 'label.doc_detail'|trans({}, 'pilot') }}
                    <textarea name="detail" rows="14" class="form-control font-monospace small">{{ doc.detail }}</textarea>
                </label>
                <div><button class="btn btn-sm btn-primary">{{ 'label.card_save'|trans({}, 'pilot') }}</button></div>
            </form>
        </details>
    </div>
{% endblock %}
