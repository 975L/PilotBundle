{# A card as a tile in the project's colour, opened by a click anywhere on it, dragged with the mouse to another day or to the backlog: title, project (left out on the project's own page), date coloured by its nearness, steps ticked, status, the next action, one gesture. The rest is on its page #}
{% set next = card.checklist|filter(step => not (step.done ?? false))|first %}
{% set ticked = card.checklist|filter(step => step.done ?? false)|length %}
<div class="card h-100 pilot-card pilot-ink-{{ card.project.slug }}" data-pilot-card-drag-target="card" data-schedule-url="{{ path('management_pilot_card_gesture', {id: card.id, gesture: 'schedule'}) }}" data-token="{{ csrf_token('management_pilot_card_gesture' ~ card.id) }}">
    <div class="card-body d-flex flex-column gap-2 p-3">
        <a href="{{ path('management_pilot_card', {id: card.id}) }}" draggable="false" data-card-id="{{ card.id }}" class="fw-semibold text-decoration-none text-body stretched-link pilot-card-open">{{ card.title }}</a>
        {% if next %}
            <div class="small text-body-secondary">{{ 'label.next'|trans({}, 'pilot') }} {{ next.t }}</div>
        {% endif %}
        <div class="d-flex flex-wrap align-items-center gap-1 small mt-auto">
            {% if project is not defined %}<span class="badge text-white pilot-badge pilot-color-{{ card.project.slug }}">{{ card.project.name }}</span>{% endif %}
            {% if card.due %}
                {# Late in red, within two weeks in amber, while it is still to do #}
                {% set open = card.status.value != 'done' %}
                <span class="badge {{ open and card.due < date('today') ? 'text-bg-danger' : (open and card.due <= date('+14 days') ? 'text-bg-warning' : 'text-bg-light') }}">{{ card.due|format_date('short') }}</span>
            {% endif %}
            {% if card.checklist is not empty %}<span class="text-body-secondary" title="{{ 'label.steps_done'|trans({}, 'pilot') }}">{{ ticked }}/{{ card.checklist|length }}</span>{% endif %}
            <span class="badge text-bg-light">{{ card.status.label|trans }}</span>
            {% if card.waitingOn %}<span class="badge text-bg-info">{{ 'label.waiting_on'|trans({'%who%': card.waitingOn}, 'pilot') }}</span>{% endif %}
            {% if card.status.value != 'done' %}
                <form method="post" action="{{ path('management_pilot_card_gesture', {id: card.id, gesture: 'done'}) }}" class="ms-auto pilot-card-gesture">
                    <input type="hidden" name="_token" value="{{ csrf_token('management_pilot_card_gesture' ~ card.id) }}">
                    <button class="btn btn-sm btn-outline-success" title="{{ 'label.done'|trans({}, 'pilot') }}" aria-label="{{ 'label.done'|trans({}, 'pilot') }}"><i class="fas fa-check"></i></button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
