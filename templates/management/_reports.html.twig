{# The reports a machine sent: a table per report, with the actions offered on the whole table and on each row (a value to type in when the action asks for one) #}
{% for report in reports %}
    {% set token = csrf_token('management_pilot_report_run' ~ report.id) %}
    {% set page_project = project ?? null %}
    <section class="mb-4 pilot-report" data-pilot-fold="report-{{ report.key }}">
        <div class="d-flex flex-wrap align-items-center gap-2 pilot-fold-head">
            <h2 class="h5 mb-0">{{ report.label }}</h2>
            <span class="small text-body-secondary">{{ 'label.report_scanned'|trans({'%date%': report.scannedAt|format_datetime('short', 'short')}, 'pilot') }}</span>
            {% for index, action in report.globals %}
                {% include '@c975LPilot/management/_report_action.html.twig' with {row: null} %}
            {% endfor %}
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle small mt-2">
                <thead><tr>{% for column in report.columns %}<th scope="col">{{ column.label }}</th>{% endfor %}<th scope="col"></th></tr></thead>
                <tbody>
                    {% for row in report.rowsFor(page_project) %}
                        {% set values = report.rows[row] %}
                        <tr>
                            {% for column in report.columns %}
                                {% set value = values[column.key] ?? null %}
                                <td>{{ value is same as(true) ? '✓' : (value is same as(false) ? '' : value) }}</td>
                            {% endfor %}
                            <td class="text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    {% for index, action in report.actions %}
                                        {% if report.applies(action, row) %}{% include '@c975LPilot/management/_report_action.html.twig' %}{% endif %}
                                    {% endfor %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endfor %}
