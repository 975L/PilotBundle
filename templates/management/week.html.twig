{% extends '@c975LPilot/management/_layout.html.twig' %}

{% block pilot %}
    <h1>{{ 'label.week'|trans({}, 'pilot') }}</h1>
    <p class="text-body-secondary">{{ 'label.info_week'|trans({}, 'pilot') }}</p>

    {# The machine work under way first, before anything else #}
    {% include '@c975LPilot/management/_runs.html.twig' %}

    {% if credits is not empty %}
        <div class="row g-2 mb-4 pilot-credits">
            {% for credit in credits %}
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="border rounded p-2 h-100{{ credit.empty ? ' border-danger' }}">
                        <div class="small text-body-secondary text-uppercase">{{ credit.label }}</div>
                        {% if credit.manual %}
                            <form method="post" action="{{ path('management_pilot_credit', {id: credit.id}) }}" class="d-flex gap-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('pilot_credit' ~ credit.id) }}">
                                <input type="number" min="0" name="remaining" value="{{ credit.remaining }}" placeholder="{{ 'label.credit_type_in'|trans({}, 'pilot') }}" aria-label="{{ credit.label }}" class="form-control form-control-sm">
                                <button class="btn btn-sm btn-outline-secondary" title="{{ 'label.credit_save'|trans({}, 'pilot') }}" aria-label="{{ 'label.credit_save'|trans({}, 'pilot') }}"><i class="fas fa-check"></i></button>
                            </form>
                        {% else %}
                            <div class="fs-5{{ credit.empty ? ' text-danger' }}">{{ credit.remaining is null ? '?' : credit.remaining|format_number }}{% if credit.total %} / {{ credit.total|format_number }}{% endif %} {{ credit.unit }}</div>
                        {% endif %}
                        <div class="small text-body-secondary">
                            {% if credit.renewsOn %}{{ 'label.credit_renews_on'|trans({'%date%': credit.renewsOn|format_date('short')}, 'pilot') }}{% endif %}
                            {% if credit.note %} · {{ credit.note }}{% endif %}
                            {% if credit.updatedAt %} · {{ credit.updatedAt|format_date('short') }}{% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}


    {% if waiting is not empty %}
        <section class="mb-4">
            <h2 class="h5">{{ 'label.waiting'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards">
                {% for card in waiting %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}
    {% include '@c975LPilot/management/_reports.html.twig' %}

    {% if late is not empty %}
        <section class="mb-4">
            <h2 class="h5 text-danger">{{ 'label.late'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards">
                {% for card in late %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if late is empty and days is empty and later is empty %}
        <p>{{ 'label.nothing_planned'|trans({}, 'pilot') }}</p>
    {% endif %}

    {% set this_month = today|date('Y-m-01') %}
    {% if spend[this_month] is defined %}
        <h2 class="h6 text-body-secondary">{{ 'label.spend_month'|trans({'%month%': this_month|format_date(pattern: 'MMMM y')}, 'pilot') }}</h2>
        {% include '@c975LPilot/management/_spend.html.twig' with {month: this_month} %}
    {% endif %}

    {% for day, cards in days %}
        <h2 class="h5">{{ day|format_date('full') }}</h2>
        <div class="pilot-cards pilot-drop mb-4" data-pilot-card-drag-target="zone" data-due="{{ day }}">
            {% for card in cards %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
        </div>
    {% endfor %}

    {# The later deadlines month by month, every card shown, the month written larger than a day #}
    {% for month, cards in later %}
        <h2 class="h3 mt-5 pilot-month">{{ month|format_date(pattern: 'MMMM y')|capitalize }}</h2>
        {% if spend[month] is defined %}
            <p class="small text-body-secondary mb-1">{{ 'label.spend_month'|trans({'%month%': month|format_date(pattern: 'MMMM y')}, 'pilot') }}</p>
            {% include '@c975LPilot/management/_spend.html.twig' %}
        {% endif %}
        <div class="pilot-cards mb-4">
            {% for card in cards %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
        </div>
    {% endfor %}
{% endblock %}
