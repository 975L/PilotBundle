{% extends '@c975LPilot/management/_layout.html.twig' %}

{% block pilot %}
    {# The name edited in place by a click on it (pilot-inline-edit), the address of the page kept #}
    <div data-controller="pilot-inline-edit">
        <div class="d-flex align-items-center gap-2 mb-2">
            {# The colour chosen here, saved as soon as it is picked #}
            <form method="post" action="{{ path('management_pilot_project_color', {slug: project.slug}) }}" class="pilot-project-color">
                <input type="hidden" name="_token" value="{{ csrf_token('pilot_project_color' ~ project.id) }}">
                <input type="color" name="color" value="{{ project.color }}" class="form-control form-control-color" data-pilot-autosubmit title="{{ 'label.project_color'|trans({}, 'pilot') }}" aria-label="{{ 'label.project_color'|trans({}, 'pilot') }}">
            </form>
            <h1 class="pilot-inline-view mb-0" data-pilot-inline-edit-target="view" data-action="click->pilot-inline-edit#edit keydown.enter->pilot-inline-edit#edit" tabindex="0" title="{{ 'label.card_edit'|trans({}, 'pilot') }}">{{ project.name }}</h1>
        </div>
        <form method="post" action="{{ path('management_pilot_project_rename', {slug: project.slug}) }}" hidden data-pilot-inline-edit-target="form" data-action="focusout->pilot-inline-edit#leave keydown->pilot-inline-edit#key" class="mb-2">
            <input type="hidden" name="_token" value="{{ csrf_token('pilot_project_rename' ~ project.id) }}">
            <input name="name" value="{{ project.name }}" maxlength="100" class="form-control form-control-lg" required aria-label="{{ 'label.project'|trans({}, 'pilot') }}">
        </form>
    </div>
    <p class="text-body-secondary">{{ 'label.info_project'|trans({}, 'pilot') }}</p>

    {# The machine work under way on the project first #}
    {% include '@c975LPilot/management/_runs.html.twig' %}
    {% for site in project.sites %}
        <a href="https://{{ site }}" target="_blank" rel="noopener" class="me-2">{{ site }}</a>
    {% endfor %}

    {% set objectives = docs|filter(doc => doc.kind.value == 'objectives')|first %}
    <section class="mt-3 pilot-objectives" data-pilot-fold="objectives"{% if objectives %} data-controller="pilot-tasks" data-pilot-tasks-url-value="{{ path('management_pilot_doc_task', {slug: objectives.slug}) }}" data-pilot-tasks-token-value="{{ csrf_token('pilot_doc_task' ~ objectives.id) }}" data-pilot-tasks-label-value="{{ 'label.objective_reached'|trans({}, 'pilot') }}" data-pilot-tasks-failed-label-value="{{ 'label.gesture_expired'|trans({}, 'pilot') }}"{% endif %}>
        <div class="d-flex align-items-center gap-2 pilot-fold-head">
            <h2 class="h5 mb-0">{{ 'label.objectives'|trans({}, 'pilot') }}</h2>
            {% if objectives %}
                <a href="{{ path('management_pilot_doc', {slug: objectives.slug}) }}" data-pilot-dialog="doc-{{ objectives.slug }}" class="btn btn-sm btn-link p-0 pilot-doc-edit pilot-objectives-edit" title="{{ 'label.objectives_write'|trans({}, 'pilot') }}" aria-label="{{ 'label.objectives_write'|trans({}, 'pilot') }}"><i class="fas fa-pen"></i></a>
            {% endif %}
        </div>
        {% if objectives and (objectives.summary or objectives.detail) %}
            {% if objectives.summary %}<div class="small">{{ objectives.summary|pilot_markdown }}</div>{% endif %}
            {% if objectives.detail %}<div class="small">{{ objectives.detail|pilot_markdown }}</div>{% endif %}
        {% else %}
            <form method="post" action="{{ path('management_pilot_project_objectives', {slug: project.slug}) }}" class="d-flex align-items-center gap-2">
                <input type="hidden" name="_token" value="{{ csrf_token('pilot_project_objectives' ~ project.id) }}">
                <span class="text-body-secondary small">{{ 'label.objectives_empty'|trans({}, 'pilot') }}</span>
                <button class="btn btn-sm btn-outline-primary pilot-objectives-write"><i class="fas fa-pen me-1"></i>{{ 'label.objectives_write'|trans({}, 'pilot') }}</button>
            </form>
        {% endif %}
    </section>

    {% set recurring = actions|filter(action => not action.card) %}
    {% if recurring is not empty %}
        <div class="d-flex flex-wrap gap-2 mt-3 pilot-project-actions">
            {% for action in recurring %}
                <form method="post" action="{{ path('management_pilot_project_run', {slug: project.slug}) }}" class="d-flex gap-1 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('pilot_project_run' ~ project.id) }}">
                    <input type="hidden" name="action" value="{{ action.key }}">
                    {% for name in action.params %}
                        <input name="params[{{ name }}]" placeholder="{{ name }}" aria-label="{{ name }}" class="form-control form-control-sm">
                    {% endfor %}
                    <button class="btn btn-sm btn-primary" title="{{ action.help ? action.help ~ ' · ' }}{{ action.machine }}"><i class="fas fa-play me-1"></i>{{ action.label }}</button>
                </form>
            {% endfor %}
        </div>
    {% endif %}


    {% if templates is not empty %}
        <form method="get" action="{{ path('management_pilot_plan_new', {slug: project.slug}) }}" class="d-flex gap-2 align-items-end mt-3 pilot-plan-start">
            <label class="form-label mb-0">{{ 'label.plan_new'|trans({}, 'pilot') }}
                <select name="template" class="form-select form-select-sm">
                    {% for template in templates %}<option value="{{ template.id }}">{{ template.name }}</option>{% endfor %}
                </select>
            </label>
            <button class="btn btn-sm btn-outline-primary">{{ 'label.plan_next'|trans({}, 'pilot') }}</button>
        </form>
        {# The templates offered here, each opened on its own form to change its steps #}
        <p class="small mt-1 mb-0 pilot-templates">{{ 'label.templates_offered'|trans({}, 'pilot') }}
            {% for template in templates %}<a href="{{ ea_url().setController('c975L\\PilotBundle\\Controller\\Management\\PlanTemplateCrudController').setAction('edit').setEntityId(template.id) }}" class="ms-1">{{ template.name }}</a>{% endfor %}
        </p>
    {% endif %}

    <h2 class="h5 mt-4">{{ 'label.card_new'|trans({}, 'pilot') }}</h2>
    {% include '@c975LPilot/management/_card_new.html.twig' with {new_project: project} %}

    {# Every open card together, the dated ones first, ordered by dragging them #}
    <section class="mt-4" data-pilot-fold="cards">
        <h2 class="h5 pilot-fold-head">{{ 'label.cards'|trans({}, 'pilot') }}</h2>
        <div class="pilot-cards pilot-drop" data-pilot-card-drag-target="zone">
            {% for card in cards %}{% include '@c975LPilot/management/_card.html.twig' %}{% else %}<p class="text-body-secondary">{{ 'label.cards_empty'|trans({}, 'pilot') }}</p>{% endfor %}
        </div>
    </section>

    <div class="mt-4">{% include '@c975LPilot/management/_reports.html.twig' %}</div>

    {% set characters = docs|filter(doc => doc.kind.value == 'character') %}
    {% if characters is not empty %}
        <section class="mt-4" data-pilot-fold="characters">
            <h2 class="h5 pilot-fold-head">{{ 'label.characters'|trans({}, 'pilot') }}</h2>
            <div class="pilot-characters">
                {% for doc in characters %}{% include '@c975LPilot/management/_character.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {# The references common to the project, as tiles opening in the dialog; one that belongs to a single card is on that card #}
    {% if references is not empty %}
        <section class="mt-4" data-pilot-fold="docs">
            <h2 class="h5 pilot-fold-head">{{ 'label.docs'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards">
                {% for doc in references %}{% include '@c975LPilot/management/_reference.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if done is not empty %}
        <details class="mt-4">
            <summary>{{ 'label.done_cards'|trans({'%count%': done|length}, 'pilot') }}</summary>
            <div class="pilot-cards mt-2">
                {% for card in done %}{% include '@c975LPilot/management/_card.html.twig' %}{% endfor %}
            </div>
        </details>
    {% endif %}
{% endblock %}
