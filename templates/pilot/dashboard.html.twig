{% extends '@c975LPilot/pilot/_layout.html.twig' %}

{% block pilot %}
    <h1>{{ 'label.dashboard'|trans({}, 'pilot') }}</h1>
    <p class="pilot-muted">{{ 'label.info_week'|trans({}, 'pilot') }}</p>

    {# The machine work under way first, before anything else #}
    {% include '@c975LPilot/pilot/_runs.html.twig' %}

    {% if credits is not empty %}
        {# The services read again on demand, the ones typed in by hand left as they are #}
        <form method="post" action="{{ path('pilot_credits_refresh') }}" class="pilot-row pilot-row-end pilot-mb-xs pilot-credits-refresh">
            <input type="hidden" name="_token" value="{{ csrf_token('pilot_credits_refresh') }}">
            <button class="pilot-btn pilot-btn-ghost">{{ pilot_icon('rotate') }}{{ 'label.credits_refresh'|trans({}, 'pilot') }}</button>
        </form>
        {# Each tile bordered by the time left to place its credit before the renewal, what the planned steps overspend said in it #}
        <div class="pilot-mb-lg pilot-credits">
            {% for credit in credits %}
                {% set short = outlook|filter(line => line.credit.key == credit.key and line.left < 0)|first %}
                <div class="pilot-credit{{ tones[credit.key] is defined ? ' pilot-credit-' ~ tones[credit.key] }}{{ credit.empty ? ' pilot-credit-empty' }}">
                        <div class="pilot-small pilot-muted pilot-upper">{{ credit.label }}</div>
                        {% if credit.manual %}
                            <form method="post" action="{{ path('pilot_credit', {id: credit.id}) }}" class="pilot-row pilot-row-tight pilot-row-nowrap">
                                <input type="hidden" name="_token" value="{{ csrf_token('pilot_credit' ~ credit.id) }}">
                                <input type="number" min="0" name="remaining" value="{{ credit.remaining }}" placeholder="{{ 'label.credit_type_in'|trans({}, 'pilot') }}" aria-label="{{ credit.label }}">
                                <button class="pilot-btn pilot-btn-icon" title="{{ 'label.credit_save'|trans({}, 'pilot') }}" aria-label="{{ 'label.credit_save'|trans({}, 'pilot') }}">{{ pilot_icon('check') }}</button>
                            </form>
                        {% else %}
                            <div class="pilot-credit-value{{ credit.empty ? ' pilot-danger-text' }}">{{ credit.remaining is null ? '?' : credit.remaining|format_number }}{% if credit.total %} / {{ credit.total|format_number }}{% endif %} {{ credit.unit }}</div>
                        {% endif %}
                        <div class="pilot-small pilot-muted">
                            {% if credit.renewsOn %}{{ 'label.credit_renews_on'|trans({'%date%': credit.renewsOn|format_date('short')}, 'pilot') }}{% endif %}
                            {% if credit.note %} · {{ credit.note }}{% endif %}
                            {% if credit.updatedAt %} · {{ credit.updatedAt|format_date('short') }}{% endif %}
                        </div>
                        {% if short %}<div class="pilot-small pilot-danger-text">{{ 'label.outlook_short'|trans({'%amount%': short.left|abs|format_number, '%unit%': credit.unit, '%date%': short.renewsOn|format_date('short')}, 'pilot') }}</div>{% endif %}
                </div>
            {% endfor %}
        </div>
        {% include '@c975LPilot/pilot/_outlook.html.twig' %}
    {% endif %}


    {% if waiting is not empty %}
        <section class="pilot-mb-lg">
            <h2 class="pilot-title">{{ 'label.waiting'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards">
                {% for card in waiting %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}
    {% include '@c975LPilot/pilot/_reports.html.twig' %}

    {% if late is not empty %}
        <section class="pilot-mb-lg">
            <h2 class="pilot-heading pilot-danger-text">{{ 'label.late'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards">
                {% for card in late %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if late is empty and days is empty and later is empty %}
        <p>{{ 'label.nothing_planned'|trans({}, 'pilot') }}</p>
    {% endif %}

    {% set this_month = today|date('Y-m-01') %}
    {% if spend[this_month] is defined %}
        <h2 class="pilot-subtitle pilot-muted">{{ 'label.spend_month'|trans({'%month%': this_month|format_date(pattern: 'MMMM y')}, 'pilot') }}</h2>
        {% include '@c975LPilot/pilot/_spend.html.twig' with {month: this_month} %}
    {% endif %}

    {# The coming days side by side, each one a drop zone for its cards #}
    {% if days is not empty %}
        <div class="pilot-days pilot-mb-lg">
            {% for day, cards in days %}
                <section class="pilot-day">
                    <h2 class="pilot-title">{{ day|format_date('full') }}</h2>
                    <div class="pilot-cards pilot-drop" data-pilot-card-drag-target="zone" data-due="{{ day }}">
                        {% for card in cards %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}

    {# The later deadlines month by month, every card shown, the month written larger than a day #}
    {% for month, cards in later %}
        <h2 class="pilot-mt-lg pilot-month">{{ month|format_date(pattern: 'MMMM y')|capitalize }}</h2>
        {% if spend[month] is defined %}
            <p class="pilot-small pilot-muted pilot-mb-xs">{{ 'label.spend_month'|trans({'%month%': month|format_date(pattern: 'MMMM y')}, 'pilot') }}</p>
            {% include '@c975LPilot/pilot/_spend.html.twig' %}
        {% endif %}
        <div class="pilot-cards pilot-mb-lg">
            {% for card in cards %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
        </div>
    {% endfor %}
{% endblock %}
