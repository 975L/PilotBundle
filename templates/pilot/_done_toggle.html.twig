{# A card marked done, or a done one put back to do, by one click; the reopening named in words when toggle_named is set #}
{% set finished = card.status.value == 'done' %}
<form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: finished ? 'reopen' : 'done'}) }}"{% if toggle_class is defined %} class="{{ toggle_class }}"{% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token('pilot_card_gesture' ~ card.id) }}">
    {% if finished %}
        <button class="pilot-btn pilot-card-reopen" title="{{ 'label.reopen'|trans({}, 'pilot') }}" aria-label="{{ 'label.reopen'|trans({}, 'pilot') }}">{{ pilot_icon('rotate-left') }}{% if toggle_named ?? false %}{{ 'label.reopen'|trans({}, 'pilot') }}{% endif %}</button>
    {% else %}
        <button class="pilot-btn pilot-btn-outline-success" title="{{ 'label.done'|trans({}, 'pilot') }}" aria-label="{{ 'label.done'|trans({}, 'pilot') }}">{{ pilot_icon('check') }}</button>
    {% endif %}
</form>
