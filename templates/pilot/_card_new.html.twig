{# A + button opening the adding, into the given collection when there is one: a card in one line, Enter sending it, laid with the space's template and pointing to the given reference when there is one; several from a pasted list when asked, a title already there left aside #}
<details class="pilot-card-new">
    <summary class="pilot-btn pilot-btn-outline-primary pilot-btn-icon" title="{{ 'label.card_new'|trans({}, 'pilot') }}" aria-label="{{ 'label.card_new'|trans({}, 'pilot') }}">{{ pilot_icon('plus') }}</summary>
    <div class="pilot-card-new-panel">
        <form method="post" action="{{ path('pilot_card_new') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('pilot_card_new') }}">
            <input type="hidden" name="project" value="{{ new_project.id }}">
            {% if new_doc is defined %}<input type="hidden" name="doc" value="{{ new_doc.id }}">{% endif %}
            {% if new_set ?? null %}<input type="hidden" name="collection" value="{{ new_set.id }}">{% endif %}
            <input name="title" maxlength="500" placeholder="{{ 'label.info_card_new'|trans({}, 'pilot') }}" aria-label="{{ 'label.card_new'|trans({}, 'pilot') }}" required>
        </form>
        {% if new_paste ?? false %}
            {% set paste_label = 'label.cards_add'|trans({'%item%': (new_set ?? null) and new_set.item ? new_set.item : 'label.card'|trans({}, 'pilot')|lower}, 'pilot') %}
            <form method="post" action="{{ path('pilot_project_cards', {slug: new_project.slug}) }}" class="pilot-stack pilot-mt-sm pilot-cards-paste">
                <input type="hidden" name="_token" value="{{ csrf_token('pilot_project_cards' ~ new_project.id) }}">
                {% if new_set ?? null %}<input type="hidden" name="collection" value="{{ new_set.id }}">{% endif %}
                <label class="pilot-small pilot-muted" for="pilot-cards-paste-{{ new_project.id }}">{{ paste_label }}</label>
                <textarea id="pilot-cards-paste-{{ new_project.id }}" name="titles" rows="4" required placeholder="{{ 'label.info_cards_add'|trans({'%max%': max_lines}, 'pilot') }}"></textarea>
                <div><button class="pilot-btn pilot-btn-outline-primary">{{ 'label.card_add'|trans({}, 'pilot') }}</button></div>
            </form>
        {% endif %}
    </div>
</details>
