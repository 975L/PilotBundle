{# The kinds of setting as tabs, the current one marked #}
<ul class="pilot-tab-list pilot-settings-tabs">
    {% for name, item in pilot_setting_kinds() %}
        <li><a href="{{ path('pilot_settings_list', {kind: name}) }}" class="pilot-tab{{ name == kind ? ' active' }}">{{ pilot_icon(item.icon) }}{{ item.title|trans({}, 'pilot') }}</a></li>
    {% endfor %}
</ul>
