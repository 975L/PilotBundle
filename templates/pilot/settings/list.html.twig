{% extends '@c975LPilot/pilot/_layout.html.twig' %}

{# The rows of one kind of setting, each edited by a click on its line (the pen stretched over it) or deleted from it, a new one added above #}
{% block pilot %}
    <div class="pilot-row pilot-mb-sm">
        <h1 class="pilot-m0">{{ 'label.settings'|trans({}, 'pilot') }}</h1>
        {% if settings.new %}<a href="{{ path('pilot_settings_new', {kind: kind}) }}" class="pilot-btn pilot-btn-primary pilot-push pilot-settings-new">{{ pilot_icon('plus') }}{{ settings.label|trans({}, 'pilot') }}</a>{% endif %}
    </div>
    {% include '@c975LPilot/pilot/settings/_nav.html.twig' %}
    <p class="pilot-muted">{{ settings.description|trans({}, 'pilot') }}</p>
    {% if rows is empty %}
        <p class="pilot-muted">{{ 'label.settings_empty'|trans({}, 'pilot') }}</p>
    {% else %}
        <div class="pilot-table-wrap">
            <table class="pilot-table{{ settings.edit ? ' pilot-table-hover' }}">
                <thead><tr>{% for column in settings.columns %}<th scope="col">{{ column.label|trans({}, 'pilot') }}</th>{% endfor %}<th></th></tr></thead>
                <tbody>
                    {% for row in rows %}
                        <tr{% if settings.edit %} class="pilot-row-link"{% endif %}>
                            {% for column in settings.columns %}
                                {% set value = attribute(row, column.property) %}
                                <td>
                                    {%- if value is same as(true) %}{{ pilot_icon('check', 'pilot-success-text') }}
                                    {%- elseif value is same as(false) or value is null %}
                                    {%- elseif value is iterable %}{{ value|map(item => item ~ '')|join(', ') }}
                                    {%- elseif value.timestamp is defined %}{{ value|format_datetime('short', 'short') }}
                                    {%- else %}{{ value }}{% endif -%}
                                </td>
                            {% endfor %}
                            <td class="pilot-end pilot-nowrap">
                                {% if settings.edit %}<a href="{{ path('pilot_settings_edit', {kind: kind, id: row.id}) }}" class="pilot-btn pilot-btn-ghost pilot-row-link-target" title="{{ 'label.settings_edit'|trans({}, 'pilot') }}" aria-label="{{ 'label.settings_edit'|trans({}, 'pilot') }}">{{ pilot_icon('pen') }}</a>{% endif %}
                                {# Deleted once the second button confirms it #}
                                <details class="pilot-inline pilot-row-link-above">
                                    <summary class="pilot-btn pilot-btn-ghost pilot-btn-delete" title="{{ 'label.settings_delete'|trans({}, 'pilot') }}" aria-label="{{ 'label.settings_delete'|trans({}, 'pilot') }}">{{ pilot_icon('trash') }}</summary>
                                    <form method="post" action="{{ path('pilot_settings_delete', {kind: kind, id: row.id}) }}" class="pilot-mt-xs">
                                        <input type="hidden" name="_token" value="{{ csrf_token('pilot_settings_delete' ~ kind ~ row.id) }}">
                                        <button class="pilot-btn pilot-btn-danger">{{ 'label.settings_delete_confirm'|trans({}, 'pilot') }}</button>
                                    </form>
                                </details>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
