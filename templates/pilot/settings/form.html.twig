{% extends '@c975LPilot/pilot/_layout.html.twig' %}
{% form_theme form 'form_div_layout.html.twig' %}

{# One row of a setting created or edited, the one edited deleted from here too; a template's steps added, removed and ordered in place (pilot-collection); a space, set from its own pages, back to them #}
{% block pilot %}
    {% set listed = settings.nav ?? true %}
    {% set back = listed ? path('pilot_settings_list', {kind: kind}) : (row ? path('pilot_project', {slug: row.slug}) : path('pilot_dashboard')) %}
    <h1>{{ listed ? 'label.settings'|trans({}, 'pilot') : settings.label|trans({}, 'pilot') }}</h1>
    {% if listed %}{% include '@c975LPilot/pilot/settings/_nav.html.twig' %}{% endif %}
    <h2 class="pilot-title">{{ settings.label|trans({}, 'pilot') }}{% if row %} · {{ attribute(row, settings.columns[0].property) }}{% endif %}</h2>
    {{ form_start(form, {attr: {class: 'pilot-form pilot-settings-form'}}) }}
        {% for child in form %}
            {% if child.vars.name == 'steps' %}
                <fieldset class="pilot-fieldset" data-controller="pilot-collection" data-pilot-collection-index-value="{{ child|length }}" data-pilot-collection-prototype-value="{{ form_widget(child.vars.prototype)|e('html_attr') }}" data-pilot-collection-remove-label-value="{{ 'label.step_remove'|trans({}, 'pilot') }}">
                    <legend class="pilot-subtitle">{{ form_label(child) }}</legend>
                    <ol class="pilot-bare-list pilot-stack" data-pilot-collection-target="list">
                        {% for step in child %}
                            <li class="pilot-framed" data-pilot-collection-target="entry">
                                {{ form_widget(step) }}
                                <button type="button" class="pilot-btn pilot-btn-ghost pilot-btn-delete" data-action="pilot-collection#remove">{{ 'label.step_remove'|trans({}, 'pilot') }}</button>
                            </li>
                        {% endfor %}
                    </ol>
                    <button type="button" class="pilot-btn pilot-btn-outline-primary" data-action="pilot-collection#add">{{ pilot_icon('plus') }}{{ 'label.step_new'|trans({}, 'pilot') }}</button>
                    {{ form_errors(child) }}
                </fieldset>
            {% elseif child.vars.name != '_token' %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
        <div class="pilot-row">
            <button class="pilot-btn pilot-btn-primary pilot-btn-lg">{{ 'label.settings_save'|trans({}, 'pilot') }}</button>
            <a href="{{ back }}" class="pilot-btn pilot-btn-ghost pilot-btn-lg">{{ 'label.settings_back'|trans({}, 'pilot') }}</a>
        </div>
    {{ form_end(form) }}
    {% if row %}
        {# Deleted once the second button confirms it #}
        <details class="pilot-mt-lg pilot-settings-delete">
            <summary class="pilot-btn pilot-btn-outline-danger">{{ pilot_icon('trash') }}{{ 'label.settings_delete'|trans({}, 'pilot') }}</summary>
            <form method="post" action="{{ path('pilot_settings_delete', {kind: kind, id: row.id}) }}" class="pilot-mt-sm">
                <input type="hidden" name="_token" value="{{ csrf_token('pilot_settings_delete' ~ kind ~ row.id) }}">
                {% if kind == 'space' %}<p class="pilot-small pilot-danger-text pilot-mb-xs">{{ 'label.project_delete_warning'|trans({}, 'pilot') }}</p>{% endif %}
                <button class="pilot-btn pilot-btn-danger">{{ 'label.settings_delete_confirm'|trans({}, 'pilot') }}</button>
            </form>
        </details>
    {% endif %}
{% endblock %}
