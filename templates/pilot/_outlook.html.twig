{# The later cards whose steps could spend the credits left before their renewal, as tiles, each with its steps' cost and what it waits for first #}
{% if outlookCards is not empty %}
    <section class="pilot-mb-lg pilot-outlook">
        <h2 class="pilot-heading pilot-warning-text">{{ 'label.outlook'|trans({}, 'pilot') }}</h2>
        <div class="pilot-cards">
            {% for offer in outlookCards %}{% include '@c975LPilot/pilot/_card.html.twig' with {card: offer.card} %}{% endfor %}
        </div>
    </section>
{% endif %}
