{# A + at the end of the tabs adding a collection by its name, opened in its tab once made; a card dropped on it opens it and goes into the new collection #}
<details class="pilot-card-new pilot-collection-new">
    <summary data-pilot-card-drag-target="set" data-collection="new" class="pilot-btn" title="{{ 'label.collection_new'|trans({}, 'pilot') }}" aria-label="{{ 'label.collection_new'|trans({}, 'pilot') }}">{{ pilot_icon('plus') }}{{ pilot_icon('layer-group') }}</summary>
    <div class="pilot-card-new-panel">
        <form method="post" action="{{ path('pilot_collection_new', {slug: project.slug}) }}" class="pilot-row pilot-row-nowrap">
            <input type="hidden" name="_token" value="{{ csrf_token('pilot_collection_new' ~ project.id) }}">
            <input type="hidden" name="card" value="">
            <input name="name" maxlength="100" required placeholder="{{ 'label.collection_new'|trans({}, 'pilot') }}" aria-label="{{ 'label.collection_new'|trans({}, 'pilot') }}">
            <button class="pilot-btn pilot-btn-primary">{{ 'label.collection_add'|trans({}, 'pilot') }}</button>
        </form>
    </div>
</details>
