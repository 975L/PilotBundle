{# The machine work under way: waiting in the queue or held by a machine, with its progress; one still waiting withdrawn, one taken stopped #}
{% if runs is not empty %}
    <section class="pilot-mb-lg pilot-runs" data-pilot-fold="runs">
        <h2 class="pilot-title pilot-fold-head">{{ 'label.runs_active'|trans({}, 'pilot') }}</h2>
        <ul class="pilot-list">
            {% for run in runs %}
                {% set card = run.card %}
                <li class="pilot-list-item pilot-row">
                    <span class="pilot-dot pilot-color-{{ card.project.slug }}"></span>
                    <a href="{{ pilot_card_path(card) }}" data-pilot-dialog="card-{{ card.id }}" class="pilot-card-open">{{ card.title }}</a>
                    <span class="pilot-tag pilot-tag-info">{{ run.status.label|trans }}</span>
                    {% if run.machine %}<span class="pilot-small pilot-muted">{{ pilot_icon('desktop', 'pilot-icon-before') }}{{ run.machine.name }}</span>{% endif %}
                    <span class="pilot-small pilot-muted">{{ run.action }} · {{ 'label.runs_since'|trans({'%date%': run.createdAt|format_datetime('short', 'short')}, 'pilot') }}</span>
                    {% if run.message %}<span class="pilot-small">{{ run.message }}</span>{% endif %}
                    {% if run.status.value == 'claimed' %}{% set shown = pilot_run_progress(run) %}<progress class="pilot-grow" max="100" value="{{ shown.value }}" title="{{ shown.estimated ? '≈ ' }}{{ shown.value }} %">{{ shown.estimated ? '≈ ' }}{{ shown.value }} %</progress>{% endif %}
                    {% if run.status.value in ['queued', 'claimed'] %}
                        <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'cancel'}) }}" class="pilot-push">
                            <input type="hidden" name="_token" value="{{ csrf_token('pilot_card_gesture' ~ card.id) }}">
                            <input type="hidden" name="run" value="{{ run.id }}">
                            <button class="pilot-btn">{{ pilot_icon(run.status.value == 'claimed' ? 'stop' : 'xmark') }}{% if run.status.value == 'claimed' %}{{ 'label.run_stop'|trans({}, 'pilot') }}{% else %}{{ 'label.run_cancel'|trans({}, 'pilot') }}{% endif %}</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
