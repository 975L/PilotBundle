{# The machine work under way: waiting in the queue or held by a machine, with its progress; one still waiting withdrawn, one taken stopped #}
{% if runs is not empty %}
    <section class="mb-4 pilot-runs" data-pilot-fold="runs">
        <h2 class="h5 pilot-fold-head">{{ 'label.runs_active'|trans({}, 'pilot') }}</h2>
        <ul class="list-group">
            {% for run in runs %}
                {% set card = run.card %}
                <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                    <span class="rounded-circle flex-shrink-0 pilot-dot pilot-color-{{ card.project.slug }}"></span>
                    <a href="{{ pilot_card_path(card) }}" data-pilot-dialog="card-{{ card.id }}" class="pilot-card-open">{{ card.title }}</a>
                    <span class="badge text-bg-light">{{ run.status.label|trans }}</span>
                    {% if run.machine %}<span class="small text-body-secondary">{{ run.machine.name }}</span>{% endif %}
                    <span class="small text-body-secondary">{{ run.action }} · {{ 'label.runs_since'|trans({'%date%': run.createdAt|format_datetime('short', 'short')}, 'pilot') }}</span>
                    {% if run.message %}<span class="small">{{ run.message }}</span>{% endif %}
                    {% if run.status.value == 'claimed' %}<progress class="flex-grow-1" max="100" value="{{ run.progress }}">{{ run.progress }} %</progress>{% endif %}
                    {% if run.status.value in ['queued', 'claimed'] %}
                        <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'cancel'}) }}" class="ms-auto">
                            <input type="hidden" name="_token" value="{{ csrf_token('pilot_card_gesture' ~ card.id) }}">
                            <input type="hidden" name="run" value="{{ run.id }}">
                            <button class="btn btn-sm btn-outline-secondary">{% if run.status.value == 'claimed' %}{{ 'label.run_stop'|trans({}, 'pilot') }}{% else %}{{ 'label.run_cancel'|trans({}, 'pilot') }}{% endif %}</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
