{# The machine work under way: held by a machine with its progress, then the queue in the order the machines take it, reordered by dragging (pilot-run-sort); one still waiting withdrawn, one taken stopped #}
{% if runs is not empty %}
    <section class="pilot-mb-lg pilot-runs" data-pilot-fold="runs">
        <h2 class="pilot-title pilot-fold-head">{{ 'label.runs_active'|trans({}, 'pilot') }}</h2>
        {# Read again every few seconds, the progress moving in place and the page reloaded once a run ends or starts (pilot-run-watch) #}
        <div hidden data-controller="pilot-run-watch" data-pilot-run-watch-url-value="{{ app.request.requestUri }}" data-pilot-run-watch-every-value="10000" data-pilot-run-watch-runs-value="{{ runs|map(run => run.id)|join('|') }}" data-pilot-run-watch-state-value="{{ runs|map(run => run.id ~ ':' ~ run.status.value ~ ':' ~ pilot_run_progress(run).value ~ ':' ~ run.message)|join('|') }}"></div>
        <ul class="pilot-list" data-controller="pilot-run-sort" data-pilot-run-sort-target="list" data-pilot-run-sort-url-value="{{ path('pilot_runs_order') }}" data-pilot-run-sort-token-value="{{ csrf_token('pilot_runs_order') }}" data-pilot-run-sort-failed-label-value="{{ 'label.order_failed'|trans({}, 'pilot') }}">
            {% for run in runs %}
                {% set card = run.card %}
                {% set queued = run.status.value == 'queued' %}
                <li class="pilot-list-item pilot-row"{% if queued %} data-pilot-run-sort-target="item" data-run-id="{{ run.id }}"{% endif %}>
                    {% if queued %}<span class="pilot-sort-handle" data-pilot-run-sort-handle title="{{ 'label.order_drag'|trans({}, 'pilot') }}">{{ pilot_icon('grip-vertical') }}</span>{% else %}<span class="pilot-sort-handle pilot-invisible" aria-hidden="true">{{ pilot_icon('grip-vertical') }}</span>{% endif %}
                    <span class="pilot-dot pilot-color-{{ card.project.slug }}"></span>
                    <a href="{{ pilot_card_path(card) }}" data-pilot-dialog="card-{{ card.id }}" class="pilot-card-open">{{ card.title }}</a>
                    <span class="pilot-tag pilot-tag-info">{{ run.status.label|trans }}</span>
                    {% if run.machine %}<span class="pilot-small pilot-muted">{{ pilot_icon('desktop', 'pilot-icon-before') }}{{ run.machine.name }}</span>{% endif %}
                    <span class="pilot-small pilot-muted" title="{{ run.action }}">{{ run.stepText ?? run.action }} · {{ 'label.runs_since'|trans({'%date%': run.createdAt|format_datetime('short', 'short')}, 'pilot') }}</span>
                    {% if run.message %}<span class="pilot-small">{{ run.message }}</span>{% endif %}
                    {% if run.status.value == 'claimed' %}{% set shown = pilot_run_progress(run) %}<progress class="pilot-grow" max="100" value="{{ shown.value }}" title="{{ shown.estimated ? '≈ ' }}{{ shown.value }} %">{{ shown.estimated ? '≈ ' }}{{ shown.value }} %</progress>{% endif %}
                    {% if run.status.value in ['queued', 'claimed'] %}
                        <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'cancel'}) }}" class="pilot-push">
                            <input type="hidden" name="_token" value="{{ csrf_token('pilot_card_gesture' ~ card.id) }}">
                            <input type="hidden" name="run" value="{{ run.id }}">
                            <button class="pilot-btn">{{ pilot_icon(run.status.value == 'claimed' ? 'stop' : 'xmark') }}{% if run.status.value == 'claimed' %}{{ 'label.run_stop'|trans({}, 'pilot') }}{% else %}{{ 'label.run_cancel'|trans({}, 'pilot') }}{% endif %}</button>
                        </form>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
