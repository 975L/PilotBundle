{# A collection's settings folded behind a gear: its name, its word for a card, its template and its sheets, saved together; deleted once the browser asked, its cards staying in the space #}
<details class="pilot-card-new pilot-collection-edit">
    <summary class="pilot-btn pilot-btn-ghost" title="{{ 'label.collection_edit'|trans({}, 'pilot') }}" aria-label="{{ 'label.collection_edit'|trans({}, 'pilot') }}">{{ pilot_icon('gear') }}</summary>
    <div class="pilot-card-new-panel">
        <form method="post" action="{{ path('pilot_collection_edit', {id: set.id}) }}" class="pilot-stack">
            <input type="hidden" name="_token" value="{{ csrf_token('pilot_collection_edit' ~ set.id) }}">
            <label class="pilot-small">{{ 'label.collection_name'|trans({}, 'pilot') }}<input name="name" value="{{ set.name }}" maxlength="100" required></label>
            <label class="pilot-small">{{ 'label.collection_item'|trans({}, 'pilot') }}<input name="item" value="{{ set.item }}" maxlength="50"></label>
            <label class="pilot-small">{{ 'label.template'|trans({}, 'pilot') }}
                <select name="template">
                    <option value="">{{ 'label.collection_no_template'|trans({}, 'pilot') }}</option>
                    {% for template in templates %}<option value="{{ template.id }}"{{ set.template and set.template.id == template.id ? ' selected' }}>{{ template.name }}</option>{% endfor %}
                </select>
            </label>
            <div class="pilot-row pilot-small">
                <input type="checkbox" name="sheets" value="1" id="pilot-collection-sheets-{{ set.id }}"{{ set.sheets ? ' checked' }}>
                <label for="pilot-collection-sheets-{{ set.id }}" title="{{ 'label.info_collection_sheets'|trans({}, 'pilot') }}">{{ 'label.collection_sheets'|trans({}, 'pilot') }}</label>
            </div>
            <div><button class="pilot-btn pilot-btn-primary">{{ 'label.collection_save'|trans({}, 'pilot') }}</button></div>
        </form>
        <form method="post" action="{{ path('pilot_collection_delete', {id: set.id}) }}" class="pilot-mt-sm" data-pilot-confirm="{{ 'label.info_collection_delete'|trans({}, 'pilot') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('pilot_collection_delete' ~ set.id) }}">
            <button class="pilot-btn pilot-btn-outline-danger">{{ pilot_icon('trash') }}{{ 'label.collection_delete'|trans({}, 'pilot') }}</button>
        </form>
    </div>
</details>
