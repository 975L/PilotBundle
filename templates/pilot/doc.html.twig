{% extends '@c975LPilot/pilot/_layout.html.twig' %}

{# A file on its own page, the part the dialog of the listing pages takes #}
{% block pilot %}
    <div class="pilot-dialog-page">
        {% include '@c975LPilot/pilot/_doc.html.twig' with {open: true} %}

        {# A new request added here points to this reference; its memory: the cards pointing to it, the open ones first, then the done ones #}
        {% if doc.project %}
            <div class="d-flex align-items-center gap-2 mt-4">
                <h2 class="h5 mb-0">{{ 'label.card_new'|trans({}, 'pilot') }}</h2>
                {% include '@c975LPilot/pilot/_card_new.html.twig' with {new_project: doc.project, new_doc: doc} %}
            </div>
        {% endif %}
        {% set done = cards|filter(card => card.status.value == 'done') %}
        {% set open = cards|filter(card => card.status.value != 'done') %}
        {% if open is not empty %}
            <h2 class="h5 mt-4">{{ 'label.cards'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards pilot-doc-cards">
                {% for card in open %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
            </div>
        {% endif %}
        {% if done is not empty %}
            <details class="mt-4">
                <summary>{{ 'label.done_cards'|trans({'%count%': done|length}, 'pilot') }}</summary>
                <div class="pilot-cards mt-2">
                    {% for card in done %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
                </div>
            </details>
        {% endif %}

        {# The title and the two floors written here, the summary for a human, the detail for Claude #}
        <details class="mt-3 pilot-doc-form">
            <summary>{{ 'label.doc_edit'|trans({}, 'pilot') }}</summary>
            <form method="post" action="{{ path('pilot_doc_edit', {slug: doc.slug}) }}" class="d-grid gap-2 mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('pilot_doc_edit' ~ doc.id) }}">
                <label class="form-label mb-0">{{ 'label.card_title'|trans({}, 'pilot') }}
                    <input name="title" value="{{ doc.title }}" maxlength="200" class="form-control" required>
                </label>
                <label class="form-label mb-0">{{ 'label.doc_summary'|trans({}, 'pilot') }}
                    <textarea name="summary" rows="5" class="form-control">{{ doc.summary }}</textarea>
                </label>
                <label class="form-label mb-0">{{ 'label.doc_detail'|trans({}, 'pilot') }}
                    <textarea name="detail" rows="14" class="form-control font-monospace small">{{ doc.detail }}</textarea>
                </label>
                <div><button class="btn btn-sm btn-primary">{{ 'label.card_save'|trans({}, 'pilot') }}</button></div>
            </form>
        </details>
    </div>
{% endblock %}
