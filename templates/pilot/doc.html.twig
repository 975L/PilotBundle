{% extends '@c975LPilot/pilot/_layout.html.twig' %}

{# A file on its own page, the part the dialog of the listing pages takes #}
{% block pilot %}
    <div class="pilot-dialog-page">
        {% include '@c975LPilot/pilot/_doc.html.twig' with {open: true} %}

        {# A new request added here points to this reference; its memory: the cards pointing to it, the open ones first, then the done ones #}
        {% if doc.project %}
            <div class="pilot-row pilot-mt-lg">
                <h2 class="pilot-title pilot-m0">{{ 'label.card_new'|trans({}, 'pilot') }}</h2>
                {% include '@c975LPilot/pilot/_card_new.html.twig' with {new_project: doc.project, new_doc: doc} %}
            </div>
        {% endif %}
        {% set done = cards|filter(card => card.status.value == 'done') %}
        {% set open = cards|filter(card => card.status.value != 'done') %}
        {% if open is not empty %}
            <h2 class="pilot-title pilot-mt-lg">{{ 'label.cards'|trans({}, 'pilot') }}</h2>
            <div class="pilot-cards pilot-doc-cards">
                {% for card in open %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
            </div>
        {% endif %}
        {% if done is not empty %}
            <details class="pilot-mt-lg">
                <summary>{{ 'label.done_cards'|trans({'%count%': done|length}, 'pilot') }}</summary>
                <div class="pilot-cards pilot-mt-sm">
                    {% for card in done %}{% include '@c975LPilot/pilot/_card.html.twig' %}{% endfor %}
                </div>
            </details>
        {% endif %}

        {# The title and the two floors written here, the summary for a human, the detail for Claude #}
        <details class="pilot-mt pilot-doc-form">
            <summary>{{ 'label.doc_edit'|trans({}, 'pilot') }}</summary>
            <form method="post" action="{{ path('pilot_doc_edit', {slug: doc.slug}) }}" class="pilot-stack pilot-mt-sm">
                <input type="hidden" name="_token" value="{{ csrf_token('pilot_doc_edit' ~ doc.id) }}">
                <label class="pilot-label">{{ 'label.card_title'|trans({}, 'pilot') }}
                    <input name="title" value="{{ doc.title }}" maxlength="200" required>
                </label>
                <label class="pilot-label">{{ 'label.doc_summary'|trans({}, 'pilot') }}
                    <textarea name="summary" rows="5">{{ doc.summary }}</textarea>
                </label>
                <label class="pilot-label">{{ 'label.doc_detail'|trans({}, 'pilot') }}
                    <textarea name="detail" rows="14" class="pilot-mono pilot-small">{{ doc.detail }}</textarea>
                </label>
                <div><button class="pilot-btn pilot-btn-primary">{{ 'label.card_save'|trans({}, 'pilot') }}</button></div>
            </form>
        </details>

        {# Deleted once the browser asked, the cards pointing to it staying without a reference #}
        {% if can_delete %}
        <form method="post" action="{{ path('pilot_doc_delete', {slug: doc.slug}) }}" class="pilot-mt-lg pilot-doc-delete" data-pilot-confirm="{{ 'label.info_doc_delete'|trans({}, 'pilot') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('pilot_doc_delete' ~ doc.id) }}">
            <button class="pilot-btn pilot-btn-outline-danger">{{ pilot_icon('trash') }}{{ 'label.doc_delete'|trans({}, 'pilot') }}</button>
        </form>
        {% endif %}
    </div>
{% endblock %}
