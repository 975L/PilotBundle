{% extends '@c975LPilot/pilot/_layout.html.twig' %}

{% block pilot %}
    <h1>{{ 'label.plan_new'|trans({}, 'pilot') }} · {{ template.name }}</h1>
    <p class="pilot-muted">{{ project.name }}</p>
    <ol class="pilot-small">
        {% for step in template.steps %}<li>{{ step.title }}{% if step.action ?? false %} <span class="pilot-muted">({{ step.action }})</span>{% endif %}</li>{% endfor %}
    </ol>
    <form method="post" class="pilot-stack pilot-plan-form">
        <input type="hidden" name="_token" value="{{ csrf_token('pilot_plan_new') }}">
        <label class="pilot-label">{{ 'label.plan_title'|trans({}, 'pilot') }}
            <input name="title" id="pilot-plan-title" required maxlength="200">
        </label>
        {% for name in variables %}
            <label class="pilot-label">{{ name }}
                <input name="values[{{ name }}]">
            </label>
        {% endfor %}
        <div><button class="pilot-btn pilot-btn-primary pilot-btn-lg pilot-plan-create">{{ 'label.plan_create'|trans({}, 'pilot') }}</button></div>
    </form>
{% endblock %}
