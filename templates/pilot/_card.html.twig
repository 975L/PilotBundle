{# A card as a tile in the project's colour, opened by a click anywhere on it, dragged with the mouse to another day, to the backlog or onto another space (on a space's page only while it has no date): title, project (left out on the project's own page), date coloured by its nearness, steps ticked, feedback still open, status, the next action, one gesture; on a tint of that colour while open, a grey background once done. The rest is on its page #}
{% import '@c975LPilot/pilot/_due.html.twig' as due %}
{% set next = card.steps|filter(step => not (step.done ?? false))|first %}
{% set ticked = card.steps|filter(step => step.done ?? false)|length %}
{% set feedback_open = card.feedback|filter(step => not (step.done ?? false))|length %}
<div class="pilot-card{{ card.sheet ? ' pilot-sheet' }}{{ card.done ? ' pilot-card-done' }} pilot-ink-{{ card.project.slug }}" {% if not card.done and (project is not defined or not card.due) %} data-pilot-card-drag-target="card"{% endif %} data-card-id="{{ card.id }}" data-project-id="{{ card.project.id }}" data-schedule-url="{{ path('pilot_card_gesture', {id: card.id, gesture: 'schedule'}) }}" data-move-url="{{ path('pilot_card_gesture', {id: card.id, gesture: 'move'}) }}" data-edit-url="{{ path('pilot_card_gesture', {id: card.id, gesture: 'edit'}) }}" data-token="{{ csrf_token('pilot_card_gesture' ~ card.id) }}">
    {# A sheet shows its picture, or its initial without one, then its title and the first line of its pitch #}
    {% if card.sheet %}
        {% if card.image %}<img src="{{ path('pilot_card_image', {id: card.id}) }}" alt="{{ card.title }}" class="pilot-sheet-image" loading="lazy" draggable="false">{% else %}<div class="pilot-sheet-image pilot-sheet-initial">{{ card.title|first|upper }}</div>{% endif %}
    {% endif %}
    <div class="pilot-box-body pilot-stack pilot-grow">
        <a href="{{ pilot_card_path(card) }}" draggable="false" data-pilot-dialog="card-{{ card.id }}" class="pilot-strong pilot-plain pilot-stretched pilot-card-open">{{ card.title }}</a>
        {% if card.sheet %}
            {% if card.note %}<div class="pilot-small pilot-muted">{{ card.note|split("\n")|first }}</div>{% endif %}
        {% else %}
        {% if next %}
            <div class="pilot-small pilot-muted">{{ 'label.next'|trans({}, 'pilot') }} {{ next.t }}</div>
        {% endif %}
        <div class="pilot-row pilot-row-tight pilot-small pilot-card-foot">
            {# Its space's badge, above the link opening the card, leads to that space #}
            {% if project is not defined %}<a href="{{ path('pilot_project', {slug: card.project.slug}) }}" draggable="false" class="pilot-tag pilot-badge pilot-card-gesture pilot-color-{{ card.project.slug }}">{{ card.project.name }}</a>{% endif %}
            {% if card.due %}
                {# Coloured by its nearness while it is still to do #}
                <span class="pilot-tag {{ due.tone(card.due, card.status.value != 'done') }}">{{ card.due|format_date('short') }}</span>
            {% endif %}
            {% if card.steps is not empty %}<span class="pilot-muted" title="{{ 'label.steps_done'|trans({}, 'pilot') }}">{{ ticked }}/{{ card.steps|length }}</span>{% endif %}
            {% if feedback_open > 0 %}<span class="pilot-tag pilot-tag-warning" title="{{ 'label.feedback'|trans({}, 'pilot') }}">{{ pilot_icon('comment') }}{{ feedback_open }}</span>{% endif %}
            {# The state only when it says more than « to do »: running, to validate, done #}
            {% if card.status.value != 'ready' %}<span class="pilot-tag{{ card.status.value == 'running' ? ' pilot-tag-info' : (card.status.value == 'failed' ? ' pilot-tag-danger' : '') }}">{{ card.status.label|trans }}</span>{% endif %}
            {% if card.waitingOn %}<span class="pilot-tag pilot-tag-info">{{ 'label.waiting_on'|trans({'%who%': card.waitingOn}, 'pilot') }}</span>{% endif %}
            {% if card.resultUrl %}<a href="{{ card.resultUrl }}" target="_blank" rel="noopener noreferrer" class="pilot-card-gesture" title="{{ 'label.card_result'|trans({}, 'pilot') }}" aria-label="{{ 'label.card_result'|trans({}, 'pilot') }}">{{ pilot_icon('arrow-up-right-from-square') }}</a>{% endif %}
            {% include '@c975LPilot/pilot/_done_toggle.html.twig' with {toggle_class: 'pilot-push pilot-card-gesture'} %}
        </div>
        {% endif %}
    </div>
</div>
