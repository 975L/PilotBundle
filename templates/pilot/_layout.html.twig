{# The piloting pages on a shell of their own, outside the back office and the site's layout: the bundle's own stylesheet and icons, light or dark as the system is, and its script; the spaces in a column on the left from a medium screen, behind a burger above the page on a phone, the settings in the same shell #}
<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ pilot_title is defined ? pilot_title ~ ' · ' }}{{ 'label.pilot'|trans({}, 'pilot') }}</title>
    <link rel="stylesheet" href="{{ asset('bundles/c975lpilot/css/pilot.min.css') }}?v={{ pilot_stylesheet_version() }}"{% guard function csp_nonce %} nonce="{{ csp_nonce('style') }}"{% endguard %}>
    {# Space colours as classes: the Content-Security-Policy refuses style attributes, a nonced <style> is the one way in #}
    <style{% guard function csp_nonce %} nonce="{{ csp_nonce('style') }}"{% endguard %}>
        {% for item in pilot_projects|filter(item => item.color matches '/^#[0-9a-fA-F]{3,8}$/') %}
        .pilot-color-{{ item.slug }} { background-color: {{ item.color }}; }
        .pilot-ink-{{ item.slug }} { --pilot-ink: {{ item.color }}; }
        {% endfor %}
    </style>
    {# The bundle's script, and ConfigBundle's back-office one for the guided-project panel walking this bundle's projects #}
    {% set pilot_entries = ['@c975l/pilot-bundle/controllers-admin.js', '@c975l/config-bundle/controllers-admin.js'] %}
    {% guard function csp_nonce %}{{ importmap(pilot_entries, {'nonce': csp_nonce('script')}) }}{% else %}{{ importmap(pilot_entries) }}{% endguard %}
</head>
<body>
    <div class="pilot-shell" data-controller="pilot-card-modal pilot-card-drag pilot-fold" data-pilot-card-drag-order-url-value="{{ path('pilot_cards_order') }}" data-pilot-card-drag-order-token-value="{{ csrf_token('pilot_cards_order') }}" data-pilot-card-drag-failed-label-value="{{ 'label.drag_failed'|trans({}, 'pilot') }}" data-pilot-card-modal-url-value="{{ path('pilot_card', {id: 0}) }}">
        <nav class="pilot-projects" aria-label="{{ 'label.projects'|trans({}, 'pilot') }}" data-controller="pilot-menu">
            <div class="pilot-row pilot-nav-pad pilot-mb-xs">
                <a href="{{ path('pilot_dashboard') }}" class="pilot-brand">{{ pilot_icon('compass', 'pilot-icon-before') }}{{ 'label.pilot'|trans({}, 'pilot') }}</a>
                <button type="button" class="pilot-btn pilot-btn-icon pilot-push pilot-phone-only pilot-menu-toggle" data-pilot-menu-target="toggle" data-action="pilot-menu#toggle" aria-expanded="false" aria-controls="pilot-menu" aria-label="{{ 'label.menu'|trans({}, 'pilot') }}" title="{{ 'label.menu'|trans({}, 'pilot') }}">{{ pilot_icon('bars') }}</button>
            </div>
            <div id="pilot-menu" class="pilot-menu">
                <p class="pilot-small pilot-muted pilot-nav-pad pilot-mb pilot-info">{{ 'label.info_pilot'|trans({}, 'pilot') }}</p>
                <div class="pilot-list pilot-list-flush pilot-small">
                    <a href="{{ path('pilot_dashboard') }}" class="pilot-list-item{{ app.request.attributes.get('_route') == 'pilot_dashboard' ? ' active' }}">{{ pilot_icon('gauge-high', 'pilot-icon-before') }}{{ 'label.dashboard'|trans({}, 'pilot') }}</a>
                    <a href="{{ path('pilot_search') }}" class="pilot-list-item{{ app.request.attributes.get('_route') == 'pilot_search' ? ' active' }}">{{ pilot_icon('magnifying-glass', 'pilot-icon-before') }}{{ 'label.search'|trans({}, 'pilot') }}</a>
                </div>
                {# A new space made from the + beside their title, the admin's #}
                <h2 class="pilot-nav-heading">{{ 'label.projects'|trans({}, 'pilot') }}{% if pilot_admin ?? false %}<a href="{{ path('pilot_settings_new', {kind: 'space'}) }}" class="pilot-push pilot-muted pilot-project-new" title="{{ 'label.project_new'|trans({}, 'pilot') }}" aria-label="{{ 'label.project_new'|trans({}, 'pilot') }}">{{ pilot_icon('plus') }}</a>{% endif %}</h2>
                <div class="pilot-list pilot-list-flush pilot-small" data-controller="pilot-project-sort" data-pilot-project-sort-target="list" data-pilot-project-sort-url-value="{{ path('pilot_projects_order') }}" data-pilot-project-sort-token-value="{{ csrf_token('pilot_projects_order') }}" data-pilot-project-sort-failed-label-value="{{ 'label.order_failed'|trans({}, 'pilot') }}">
                    {% set current = project ?? card.project ?? null %}
                    {% for item in pilot_projects %}
                        <a href="{{ path('pilot_project', {slug: item.slug}) }}" draggable="false" data-pilot-project-sort-target="item" data-pilot-card-drag-target="space" data-project-id="{{ item.id }}" title="{{ 'label.card_move'|trans({}, 'pilot') }}" class="pilot-list-item pilot-row pilot-row-nowrap pilot-project-link{{ current and current.id == item.id ? ' active' }}">
                            <span class="pilot-sort-handle" data-pilot-project-sort-handle title="{{ 'label.order_drag'|trans({}, 'pilot') }}">{{ pilot_icon('grip-vertical') }}</span>
                            <span class="pilot-dot pilot-color-{{ item.slug }}"></span>
                            <span class="pilot-grow">{{ item.name }}</span>
                            {% if pilot_open[item.id] is defined %}<span class="pilot-tag">{{ pilot_open[item.id] }}</span>{% endif %}
                        </a>
                    {% endfor %}
                </div>
                {# The settings, the admin's, each kind on its own list, then the way back to the back office #}
                {% if pilot_admin ?? false %}<h2 class="pilot-nav-heading">{{ 'label.settings'|trans({}, 'pilot') }}</h2>{% endif %}
                <div class="pilot-list pilot-list-flush pilot-small pilot-settings">
                    {% for name, setting in (pilot_admin ?? false) ? pilot_setting_kinds() : [] %}
                        <a href="{{ path('pilot_settings_list', {kind: name}) }}" class="pilot-list-item{{ app.request.attributes.get('kind') == name ? ' active' }}">{{ pilot_icon(setting.icon, 'pilot-icon-before') }}{{ setting.title|trans({}, 'pilot') }}</a>
                    {% endfor %}
                    <a href="{{ path('management') }}" class="pilot-list-item pilot-back-office">{{ pilot_icon('gauge', 'pilot-icon-before') }}{{ 'label.back_office'|trans({}, 'pilot') }}</a>
                </div>
            </div>
        </nav>
        <main class="pilot-main">
            {# A refused gesture made outside the dialog comes back as a flash #}
            {% for type, messages in app.flashes(['danger', 'success']) %}
                {% for message in messages %}<div class="pilot-alert pilot-alert-{{ type }}" role="alert">{{ message }}</div>{% endfor %}
            {% endfor %}
            {% block pilot %}{% endblock %}
        </main>
        {# A card opened from a tile shows here, over the page it was clicked on #}
        <dialog class="pilot-dialog" data-pilot-card-modal-target="dialog" aria-label="{{ 'label.card'|trans({}, 'pilot') }}">
            <form method="dialog" class="pilot-dialog-close"><button class="pilot-btn-close" aria-label="{{ 'label.close'|trans({}, 'pilot') }}">{{ pilot_icon('xmark') }}</button></form>
            <div class="pilot-dialog-body" data-pilot-card-modal-target="body"></div>
        </dialog>
        {# A screenshot opened full size over the page or the card's dialog, closed by a click anywhere #}
        <dialog class="pilot-dialog pilot-zoom" data-pilot-card-modal-target="zoom" aria-label="{{ 'label.feedback_image_view'|trans({}, 'pilot') }}">
            <img alt="{{ 'label.feedback_image_view'|trans({}, 'pilot') }}" data-pilot-card-modal-target="zoomImage">
        </dialog>
        {# The asking before a deletion, over the page or the card's dialog, as the back office asks it #}
        <dialog class="pilot-dialog pilot-confirm" data-pilot-card-modal-target="confirm" aria-labelledby="pilot-confirm-title">
            <div class="pilot-confirm-body">
                <h2 class="pilot-title pilot-mb-sm" id="pilot-confirm-title">{{ pilot_icon('triangle-exclamation', 'pilot-icon-before pilot-danger-text') }}{{ 'label.confirm_title'|trans({}, 'pilot') }}</h2>
                <p class="pilot-m0 pilot-muted" data-pilot-card-modal-target="ask"></p>
            </div>
            <form method="dialog" class="pilot-confirm-actions">
                <button value="cancel" class="pilot-btn pilot-btn-secondary pilot-btn-lg" autofocus>{{ 'label.confirm_cancel'|trans({}, 'pilot') }}</button>
                <button value="confirm" class="pilot-btn pilot-btn-danger pilot-btn-lg">{{ pilot_icon('trash') }}{{ 'label.confirm_delete'|trans({}, 'pilot') }}</button>
            </form>
        </dialog>
    </div>
    {# Where the guided-project panel comes back after each page load of a project #}
    {{ pilot_guided_project_mount() }}
</body>
</html>
