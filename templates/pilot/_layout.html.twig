{# The piloting pages on a shell of their own, outside the back office and the site's layout: the back office's look (its stylesheet, its icons, its light or dark scheme) and the bundle's script, the spaces in a column on the left from a medium screen, above the page on a phone, the settings in the same shell #}
<!doctype html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ pilot_title is defined ? pilot_title ~ ' · ' }}{{ 'label.pilot'|trans({}, 'pilot') }}</title>
    <link rel="stylesheet" href="{{ asset('app.css', 'easyadmin.assets.package') }}"{% guard function csp_nonce %} nonce="{{ csp_nonce('style') }}"{% endguard %}>
    {# Space colours as classes: the Content-Security-Policy refuses style attributes, a nonced <style> is the one way in #}
    <style{% guard function csp_nonce %} nonce="{{ csp_nonce('style') }}"{% endguard %}>
        .pilot-shell { padding: 1rem; }
        .pilot-dot { width: .6rem; height: .6rem; }
        .pilot-note { white-space: pre-line; }
        .pilot-dot, .pilot-badge { background-color: #6c757d; }
        .pilot-cards { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
        .pilot-reference { --pilot-ink: #6c757d; border-left: 4px solid var(--pilot-ink); border-style: dashed dashed dashed solid; }
        .pilot-card { --pilot-ink: #6c757d; border-top: 4px solid var(--pilot-ink); transition: border-color .15s, box-shadow .15s, transform .15s; }
        .pilot-card:hover, .pilot-card:focus-within { border-color: var(--pilot-ink); box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .12); transform: translateY(-2px); }
        .pilot-card { background-color: color-mix(in srgb, var(--pilot-ink) 12%, var(--bs-body-bg)); }
        .pilot-card-done { background-color: color-mix(in srgb, var(--bs-body-color) 22%, var(--bs-body-bg)); }
        .pilot-card .pilot-card-gesture { position: relative; z-index: 2; }
        .pilot-dialog { width: min(48rem, calc(100vw - 2rem)); max-height: calc(100vh - 2rem); border: 0; border-radius: .75rem; padding: 0; box-shadow: 0 1rem 3rem rgba(0, 0, 0, .3); background: var(--bs-body-bg); color: var(--bs-body-color); }
        .pilot-confirm { width: min(32rem, calc(100vw - 2rem)); overflow: hidden; }
        .pilot-dialog::backdrop { background: rgba(0, 0, 0, .45); }
        .pilot-dialog-close { position: sticky; top: 0; float: right; z-index: 3; }
        .pilot-sort-handle { cursor: grab; }
        .pilot-fold-head { cursor: pointer; }
        .pilot-due-past { background-color: var(--bs-purple); color: #fff; }
        .pilot-due-near { background-color: var(--bs-orange); color: #fff; }
        .pilot-card-new { position: relative; }
        .pilot-card-new > summary { list-style: none; }
        .pilot-card-new > summary::-webkit-details-marker { display: none; }
        .pilot-card-new-panel { position: absolute; z-index: 5; top: calc(100% + .25rem); left: 0; width: min(28rem, calc(100vw - 2rem)); cursor: auto; }
        .pilot-fold-head::before { content: "▾"; display: inline-block; width: 1em; transition: transform .15s; }
        .pilot-folded > .pilot-fold-head::before { transform: rotate(-90deg); }
        .pilot-folded > :not(.pilot-fold-head) { display: none; }
        .pilot-inline-view { cursor: text; border-radius: .25rem; }
        .pilot-inline-view:hover, .pilot-inline-view:focus-visible { outline: 1px dashed var(--bs-secondary-color); outline-offset: 2px; }
        .pilot-inline-form:not([hidden]) { display: inline-flex; flex-wrap: wrap; gap: .25rem; }
        /* A long step wraps beside its box instead of dropping below it */
        .pilot-step-body { flex: 0 1 auto; min-width: 0; overflow-wrap: anywhere; }
        .pilot-drop { min-height: 3.5rem; border-radius: .5rem; }
        .pilot-cards.pilot-sheets { grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); }
        .pilot-sheet-image { aspect-ratio: 1; object-fit: cover; }
        .pilot-sheet-full { max-height: 70vh; }
        .pilot-sheet-initial { place-items: center; font-size: 2.4rem; background: var(--bs-tertiary-bg); }
        .pilot-dragging .pilot-project-link.pilot-drop-over, .pilot-dragging .pilot-tabs-nav .nav-link.pilot-drop-over { outline: 2px solid var(--bs-primary); outline-offset: -2px; }
        .pilot-dragging .pilot-collection-new summary.pilot-drop-over { background: var(--bs-primary); border-color: var(--bs-primary); color: var(--bs-white); transform: scale(1.15); }
        .pilot-dragging .pilot-drop { outline: 2px dashed var(--bs-border-color); outline-offset: 4px; }
        {% for item in pilot_projects|filter(item => item.color matches '/^#[0-9a-fA-F]{3,8}$/') %}
        .pilot-color-{{ item.slug }} { background-color: {{ item.color }}; }
        .pilot-ink-{{ item.slug }} { --pilot-ink: {{ item.color }}; }
        {% endfor %}
    </style>
    {% guard function csp_nonce %}{{ importmap('@c975l/pilot-bundle/controllers-admin.js', {'nonce': csp_nonce('script')}) }}{% else %}{{ importmap('@c975l/pilot-bundle/controllers-admin.js') }}{% endguard %}
</head>
{# The back office's light or dark scheme, the visitor's own choice kept by its script #}
<body class="ea" data-ea-dark-scheme-is-enabled="true" data-ea-default-color-scheme="auto">
    <script src="{{ asset('page-color-scheme.js', 'easyadmin.assets.package') }}"{% guard function csp_nonce %} nonce="{{ csp_nonce('script') }}"{% endguard %}></script>
    <div class="row g-4 m-0 pilot-shell" data-controller="pilot-card-modal pilot-card-drag pilot-fold" data-pilot-card-drag-order-url-value="{{ path('pilot_cards_order') }}" data-pilot-card-drag-order-token-value="{{ csrf_token('pilot_cards_order') }}" data-pilot-card-drag-failed-label-value="{{ 'label.drag_failed'|trans({}, 'pilot') }}" data-pilot-card-modal-url-value="{{ path('pilot_card', {id: 0}) }}">
        <nav class="col-md-3 col-xl-2 pilot-projects" aria-label="{{ 'label.projects'|trans({}, 'pilot') }}">
            <a href="{{ path('pilot_dashboard') }}" class="d-block h5 text-decoration-none text-body px-3 mb-1"><i class="fas fa-compass me-2"></i>{{ 'label.pilot'|trans({}, 'pilot') }}</a>
            <p class="small text-body-secondary px-3 mb-3 pilot-info">{{ 'label.info_pilot'|trans({}, 'pilot') }}</p>
            <div class="list-group list-group-flush small">
                <a href="{{ path('pilot_dashboard') }}" class="list-group-item list-group-item-action{{ app.request.attributes.get('_route') == 'pilot_dashboard' ? ' active' }}"><i class="fas fa-gauge-high me-2"></i>{{ 'label.dashboard'|trans({}, 'pilot') }}</a>
                <a href="{{ path('pilot_search') }}" class="list-group-item list-group-item-action{{ app.request.attributes.get('_route') == 'pilot_search' ? ' active' }}"><i class="fas fa-magnifying-glass me-2"></i>{{ 'label.search'|trans({}, 'pilot') }}</a>
            </div>
            <h2 class="h6 text-body-secondary mt-3 mb-1 px-3">{{ 'label.projects'|trans({}, 'pilot') }}</h2>
            <div class="list-group list-group-flush small" data-controller="pilot-project-sort" data-pilot-project-sort-target="list" data-pilot-project-sort-url-value="{{ path('pilot_projects_order') }}" data-pilot-project-sort-token-value="{{ csrf_token('pilot_projects_order') }}" data-pilot-project-sort-failed-label-value="{{ 'label.order_failed'|trans({}, 'pilot') }}">
                {% set current = project ?? card.project ?? null %}
                {% for item in pilot_projects %}
                    <a href="{{ path('pilot_project', {slug: item.slug}) }}" draggable="false" data-pilot-project-sort-target="item" data-pilot-card-drag-target="space" data-project-id="{{ item.id }}" title="{{ 'label.card_move'|trans({}, 'pilot') }}" class="list-group-item list-group-item-action d-flex align-items-center gap-2 pilot-project-link{{ current and current.id == item.id ? ' active' }}">
                        <span class="text-body-secondary pilot-sort-handle" data-pilot-project-sort-handle title="{{ 'label.order_drag'|trans({}, 'pilot') }}"><i class="fas fa-grip-vertical"></i></span>
                        <span class="rounded-circle flex-shrink-0 pilot-dot pilot-color-{{ item.slug }}"></span>
                        <span class="flex-grow-1">{{ item.name }}</span>
                        {% if pilot_open[item.id] is defined %}<span class="badge text-bg-light">{{ pilot_open[item.id] }}</span>{% endif %}
                    </a>
                {% endfor %}
            </div>
            {# The settings, each kind on its own list, then the way back to the back office #}
            <h2 class="h6 text-body-secondary mt-3 mb-1 px-3">{{ 'label.settings'|trans({}, 'pilot') }}</h2>
            <div class="list-group list-group-flush small pilot-settings">
                {% for name, setting in pilot_setting_kinds() %}
                    <a href="{{ path('pilot_settings_list', {kind: name}) }}" class="list-group-item list-group-item-action{{ app.request.attributes.get('kind') == name ? ' active' }}"><i class="fas {{ setting.icon }} me-2"></i>{{ setting.title|trans({}, 'pilot') }}</a>
                {% endfor %}
                <a href="{{ path('management') }}" class="list-group-item list-group-item-action pilot-back-office"><i class="fas fa-gauge me-2"></i>{{ 'label.back_office'|trans({}, 'pilot') }}</a>
            </div>
        </nav>
        <main class="col-md-9 col-xl-10">
            {# A refused gesture made outside the dialog comes back as a flash #}
            {% for type, messages in app.flashes(['danger', 'success']) %}
                {% for message in messages %}<div class="alert alert-{{ type }}" role="alert">{{ message }}</div>{% endfor %}
            {% endfor %}
            {% block pilot %}{% endblock %}
        </main>
        {# A card opened from a tile shows here, over the page it was clicked on #}
        <dialog class="pilot-dialog" data-pilot-card-modal-target="dialog" aria-label="{{ 'label.card'|trans({}, 'pilot') }}">
            <form method="dialog" class="pilot-dialog-close p-2"><button class="btn-close" aria-label="{{ 'label.close'|trans({}, 'pilot') }}"></button></form>
            <div class="p-4 pt-2" data-pilot-card-modal-target="body"></div>
        </dialog>
        {# The asking before a deletion, over the page or the card's dialog, as the back office asks it #}
        <dialog class="pilot-dialog pilot-confirm" data-pilot-card-modal-target="confirm" aria-labelledby="pilot-confirm-title">
            <div class="p-4">
                <h2 class="h5 mb-2" id="pilot-confirm-title"><i class="fas fa-triangle-exclamation text-danger me-2"></i>{{ 'label.confirm_title'|trans({}, 'pilot') }}</h2>
                <p class="mb-0 text-body-secondary" data-pilot-card-modal-target="ask"></p>
            </div>
            <form method="dialog" class="d-flex justify-content-end gap-2 px-4 py-3 border-top bg-body-tertiary">
                <button value="cancel" class="btn btn-secondary" autofocus>{{ 'label.confirm_cancel'|trans({}, 'pilot') }}</button>
                <button value="confirm" class="btn btn-danger"><i class="fas fa-trash me-1"></i>{{ 'label.confirm_delete'|trans({}, 'pilot') }}</button>
            </form>
        </dialog>
    </div>
</body>
</html>
