{# A file: its title and summary shown, its detail unfolded by a click on them (unfolded from the start when open is true, a charter) #}
{% set download %}<a href="{{ path('pilot_doc', {slug: doc.slug}) }}" data-pilot-dialog="doc-{{ doc.slug }}" class="pilot-btn pilot-btn-ghost pilot-doc-edit" title="{{ 'label.doc_edit'|trans({}, 'pilot') }}" aria-label="{{ 'label.doc_edit'|trans({}, 'pilot') }}">{{ pilot_icon('pen') }}</a><a href="{{ path('pilot_doc_markdown', {slug: doc.slug}) }}" class="pilot-btn pilot-btn-ghost pilot-doc-download" title="{{ 'label.download_md'|trans({}, 'pilot') }}" aria-label="{{ 'label.download_md'|trans({}, 'pilot') }}">{{ pilot_icon('download') }}</a>{% endset %}
<div class="pilot-mb">
    {% if doc.detail %}
        <details class="pilot-doc"{{ (open ?? false) ? ' open' }}>
            <summary>
                <span class="pilot-subtitle">{{ doc.title }}</span> <span class="pilot-row pilot-inline">{{ download }}</span>
                {% if doc.summary %}<div class="pilot-small pilot-mt-xs">{{ doc.summary|pilot_markdown }}</div>{% endif %}
            </summary>
            <div class="pilot-small pilot-doc-body">{{ doc.detail|pilot_markdown }}</div>
        </details>
    {% else %}
        <h3 class="pilot-subtitle pilot-mb-xs pilot-row">{{ doc.title }}{{ download }}</h3>
        {% if doc.summary %}<div class="pilot-small">{{ doc.summary|pilot_markdown }}</div>{% endif %}
    {% endif %}
</div>
