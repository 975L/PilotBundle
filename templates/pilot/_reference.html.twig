{# A reference as a tile, set apart from the cards by its side stripe and icon: title and the start of its summary, opened in the dialog by a click anywhere on it #}
<div class="pilot-card pilot-reference pilot-ink-{{ doc.project.slug }}">
    <div class="pilot-box-body">
        <a href="{{ path('pilot_doc', {slug: doc.slug}) }}" data-pilot-dialog="doc-{{ doc.slug }}" class="pilot-strong pilot-plain pilot-stretched pilot-doc-edit">{{ pilot_icon(doc.kind.value == 'charter' ? 'palette' : 'file-lines', 'pilot-icon-before pilot-muted') }}{{ doc.title }}</a>
        {% if doc.summary %}{% set text = doc.summary|pilot_markdown|striptags|trim %}<p class="pilot-small pilot-muted pilot-m0 pilot-mt-xs">{{ text|length > 160 ? text|slice(0, 160) ~ '…' : text }}</p>{% endif %}
    </div>
</div>
