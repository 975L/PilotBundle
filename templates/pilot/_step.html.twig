{# One step of a card: its box, its text edited in place with the reason its run failed under it, its day, its cost, its run or its machine button, its AI copy last #}
{% import '@c975LPilot/pilot/_due.html.twig' as due %}
{# A step still waiting for the steps it needs shows greyed out, its box still ticked by hand #}
{% set waiting = not (step.done ?? false) and card.isStepWaiting(index) %}
{% set step_run = step_runs[index] ?? null %}
{% set step_failed = step_run and step_run.status.value in ['failed', 'blocked'] %}
<li class="d-flex align-items-start gap-2 mb-1" data-pilot-step-sort-target="item" data-index="{{ index }}">
    {# Moved by hand only while open and on a card of its own, a template setting the order of the cards following it #}
    {% if not (step.done ?? false) and not (card.template and card.template.checklist) %}<span class="text-body-secondary pilot-sort-handle pilot-step-handle" data-pilot-step-sort-handle title="{{ 'label.step_move'|trans({}, 'pilot') }}" aria-hidden="true"><i class="fas fa-grip-vertical fa-xs"></i></span>{% endif %}
    <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'step'}) }}" class="form-check mb-0 me-n1">
        <input type="hidden" name="_token" value="{{ token }}">
        <input type="hidden" name="index" value="{{ index }}">
        <input type="checkbox" class="form-check-input" data-pilot-autosubmit aria-label="{{ step.t }}"{{ (step.done ?? false) ? ' checked' }}>
    </form>
    {# The step's text edited in place like the card's other fields, emptied to remove the step #}
    <span data-controller="pilot-inline-edit" class="pilot-step-body">
        <span class="pilot-inline-view pilot-step-text{{ (step.done ?? false) ? ' text-decoration-line-through text-body-secondary' }}{{ waiting ? ' text-body-tertiary' }}" data-pilot-inline-edit-target="view" data-action="click->pilot-inline-edit#edit keydown.enter->pilot-inline-edit#edit" tabindex="0" title="{{ 'label.step_edit'|trans({}, 'pilot') }}">{{ step.t }}</span>
        <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'stepedit'}) }}" hidden data-pilot-inline-edit-target="form" data-action="focusout->pilot-inline-edit#leave keydown->pilot-inline-edit#key" class="pilot-inline-form">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="index" value="{{ index }}">
            <input name="text" value="{{ step.t }}" maxlength="500" class="form-control form-control-sm" aria-label="{{ 'label.step_edit'|trans({}, 'pilot') }}" placeholder="{{ 'label.info_step_edit'|trans({}, 'pilot') }}">
            {# The machine action the step hands the card to, among those the machines declared #}
            <select name="action" class="form-select form-select-sm w-auto" aria-label="{{ 'label.step_action'|trans({}, 'pilot') }}">
                <option value="">{{ 'label.step_no_action'|trans({}, 'pilot') }}</option>
                {% for key, label in action_labels %}<option value="{{ key }}"{{ key == (step.action ?? null) ? ' selected' }}>{{ label }}</option>{% endfor %}
                {% if step.action is defined and action_labels[step.action] is not defined %}<option value="{{ step.action }}" selected>{{ step.action }}</option>{% endif %}
            </select>
        </form>
        {# Why the step's run stopped, written under the step rather than hidden in a tooltip #}
        {% if step_failed and step_run.message and not (step.done ?? false) %}<span class="d-block small text-danger pilot-step-failed-reason">{{ step_run.message }}</span>{% endif %}
    </span>
    {# The day the step is planned for, a release or a publication, set or emptied in place #}
    {% if step.due is defined or can.edit %}
    <span data-controller="pilot-inline-edit" class="pilot-step-due">
        <span class="badge {{ step.due is defined ? due.tone(step.due, not (step.done ?? false)) : 'text-body-tertiary' }}{{ can.edit ? ' pilot-inline-view' }}" data-pilot-inline-edit-target="view"{% if can.edit %} data-action="click->pilot-inline-edit#edit keydown.enter->pilot-inline-edit#edit" tabindex="0" title="{{ 'label.step_due'|trans({}, 'pilot') }}"{% endif %}><i class="far fa-calendar"></i>{% if step.due is defined %} {{ step.due|date('d/m/Y') }}{% endif %}</span>
        {% if can.edit %}
        <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'stepdue'}) }}" hidden data-pilot-inline-edit-target="form" data-action="focusout->pilot-inline-edit#leave keydown->pilot-inline-edit#key" class="pilot-inline-form">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="index" value="{{ index }}">
            <input type="date" name="due" value="{{ step.due ?? '' }}" class="form-control form-control-sm w-auto" aria-label="{{ 'label.step_due'|trans({}, 'pilot') }}">
        </form>
        {% endif %}
    </span>
    {% endif %}
    {% if step.cost is defined and not (step.done ?? false) %}
        {# What the step spends, in red when the balance left is short #}
        {% set credit = credits[step.cost.credit] ?? null %}
        {% set short = credit and credit.remaining is not null and credit.remaining < step.cost.amount %}
        <span class="badge {{ short ? 'text-bg-danger' : 'text-bg-light' }}">{{ credit ? credit.label : step.cost.credit }} {{ (step.cost.guess ?? false) ? '≈ ' }}{{ step.cost.amount|format_number }}{% if credit and credit.remaining is not null %} · {{ 'label.credit_left'|trans({'%left%': credit.remaining|format_number}, 'pilot') }}{% endif %}</span>
    {% endif %}
    {% if step_run and step_run.status.value in ['queued', 'claimed'] %}
        {# The step's run under way in place of its button: queued after the others, then taken with its progress and what it is doing; withdrawn while queued, stopped once taken #}
        <span class="badge text-bg-info pilot-step-running">{{ step_run.status.label|trans }}{% if step_run.status.value == 'claimed' %} · {{ step_run.progress }} %{% endif %}</span>
        {# A queued run no online machine can take says so, the queue otherwise waiting silently #}
        {% if step_run.status.value == 'queued' and step_run.action not in online_actions %}<span class="badge text-bg-warning pilot-step-no-machine" title="{{ 'label.info_run_no_machine'|trans({}, 'pilot') }}"><i class="fas fa-plug-circle-xmark me-1"></i>{{ 'label.run_no_machine'|trans({}, 'pilot') }}</span>{% endif %}
        {% if step_run.message %}<span class="small text-body-secondary">{{ step_run.message }}</span>{% endif %}
        {% set stop_label = step_run.status.value == 'claimed' ? 'label.run_stop'|trans({}, 'pilot') : 'label.run_cancel'|trans({}, 'pilot') %}
        <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'cancel'}) }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="run" value="{{ step_run.id }}">
            <button class="btn btn-sm btn-link text-body-secondary p-0 pilot-step-cancel" title="{{ stop_label }}" aria-label="{{ stop_label }}"><i class="fas {{ step_run.status.value == 'claimed' ? 'fa-stop' : 'fa-xmark' }}"></i></button>
        </form>
    {% elseif can.run and step.action is defined and not (step.done ?? false) and card.status.value not in ['review', 'done'] %}
        {% if step_failed %}<span class="badge text-bg-danger pilot-step-failed">{{ step_run.status.label|trans }}</span>{% endif %}
        {# The machine action the step names, queued by hand right after its text, named on the button, after any action already queued; disabled while a step it waits for is still to tick #}
        <form method="post" action="{{ path('pilot_card_gesture', {id: card.id, gesture: 'runstep'}) }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="index" value="{{ index }}">
            <button class="btn btn-sm btn-outline-primary py-0 pilot-step-run"{% if waiting %} disabled{% endif %} title="{{ waiting ? 'label.step_waiting'|trans({'%steps%': card.stepAwaits(index)|join(', ')}, 'pilot') : 'label.step_run'|trans({}, 'pilot') }}"><i class="fas fa-play me-1"></i>{{ action_labels[step.action] ?? step.action }}</button>
        </form>
    {% endif %}
    {# Handed to an AI only on a card of its own, a template's step being done by its runner #}
    {% if not (card.template and card.template.checklist) %}{% include '@c975LPilot/pilot/_ai_share.html.twig' %}{% endif %}
</li>
