            </trans-unit>
            <trans-unit id="Q5GLXea">
                <source>description.guided_step_pilot_share_edit</source>
                <target>This second link lets whoever holds it read and rewrite the card, as a page or in markdown, and launch its actions; the link is the permission, the cross takes it back.</target>
            </trans-unit>
            <trans-unit id="jawCk_I">
